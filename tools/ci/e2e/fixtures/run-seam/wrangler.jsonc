{
  // A test Worker for the end-to-end tests of CI runs, before triggers exist:
  // it serves on the dev port, starts runs through the API's run seam and
  // plays a runner through the run object's calls, reads a run's stored log
  // chunks, records the UpdateLog calls a real runner makes through it, and
  // forwards every other request to fyrden-api. Never deployed.
  "name": "fyrden-e2e-run-seam",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "API", "service": "fyrden-api" }],
  "d1_databases": [{ "binding": "DIRECTORY", "database_name": "fyrden-directory" }],
  // fyrden-api's CI bucket: under wrangler dev both Workers see one local bucket of this name (measured).
  "r2_buckets": [{ "binding": "CI", "bucket_name": "fyrden-ci" }],
  "durable_objects": {
    "bindings": [
      { "name": "REPO", "class_name": "RepoDO", "script_name": "fyrden-api" },
      { "name": "RUN", "class_name": "RunDO", "script_name": "fyrden-api" }
    ]
  }
}
