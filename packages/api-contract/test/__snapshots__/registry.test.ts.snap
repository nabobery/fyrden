    "/repos/{owner}/{repo}/pulls/{pull_number}/threads": {
      "get": {
        "description": "Fyrden: a pull request's review threads, oldest first, resolved or not.",
        "operationId": "pulls.threads.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "threads": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "comments": {
                            "description": "Its comments now.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "commit_id": {
                            "type": "string",
                          },
                          "id": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "line": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "outdated": {
                            "type": "boolean",
                          },
                          "path": {
                            "type": "string",
                          },
                          "resolved": {
                            "type": "boolean",
                          },
                          "resolved_by": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "id",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "side": {
                            "enum": [
                              "LEFT",
                              "RIGHT",
                            ],
                            "type": "string",
                          },
                          "start_line": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                        },
                        "required": [
                          "id",
                          "path",
                          "side",
                          "line",
                          "start_line",
                          "commit_id",
                          "outdated",
                          "resolved",
                          "resolved_by",
                          "comments",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "threads",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
