                          "login": {
                            "type": "string",
                          },
                          "permission": {
                            "description": "\`pull\` reads, \`push\` writes, \`admin\` administers (GitHub's role names).",
                            "enum": [
                              "pull",
                              "triage",
                              "push",
                              "maintain",
                              "admin",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "login",
                          "permission",
