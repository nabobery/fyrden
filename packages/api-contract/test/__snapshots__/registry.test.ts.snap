    "/user/starred": {
      "get": {
        "description": "Lists the repositories the caller starred, most recently starred first. Repositories the caller or its token can no longer read are left out, so a page can hold fewer than \`per_page\`; keep following \`next_cursor\` until it is null.",
        "operationId": "stars.list",
        "parameters": [
          {
            "in": "query",
            "name": "per_page",
