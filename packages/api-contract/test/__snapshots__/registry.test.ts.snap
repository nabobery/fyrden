      "post": {
        "description": "Proposes merging one branch of the repository into another. Anyone who can read the repository may open one. Refused when the head has no commits the base lacks, or when a pull request between the two branches is already open. While open, \`refs/pull/{number}/head\` follows the head branch. The head may be a branch of a fork in the same network (\`owner:branch\`): its revision is imported first, and later pushes to it reach the pull request shortly after.",
        "operationId": "pulls.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "base": {
                    "description": "The branch to merge into, without refs/heads/.",
                    "maxLength": 1013,
                    "minLength": 1,
                    "type": "string",
                  },
                  "body": {
                    "maxLength": 65536,
                    "type": "string",
                  },
                  "draft": {
                    "default": false,
                    "description": "Open it as a draft.",
                    "type": "boolean",
                  },
                  "head": {
                    "description": "The branch with the changes, without refs/heads/; \`owner:branch\` for a branch of that owner's repository in the base's fork network (a fork), which the caller must be able to read.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string",
                  },
                  "head_repo": {
                    "description": "With \`owner:branch\`, the repository's name, when the owner has several in the network.",
                    "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                    "type": "string",
                  },
                  "maintainer_can_modify": {
                    "default": false,
                    "description": "With a head in a fork: let those with write access to the base change the head branch.",
                    "type": "boolean",
                  },
                  "title": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "title",
                  "head",
                  "base",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "active_lock_reason": {
                      "anyOf": [
                        {
