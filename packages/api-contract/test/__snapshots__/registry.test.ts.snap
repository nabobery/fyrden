                      "description": "The branch the source's HEAD names, when it was imported.",
                      "type": "string",
                    },
                    "error": {
                      "type": "string",
                    },
                    "id": {
                      "type": "string",
                    },
                    "refs_imported": {
                      "description": "Branches and tags created, once committed.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "refs_skipped": {
                      "description": "Refs of the source that were not imported, e.g. a name that is not valid UTF-8 (shown with \\xNN escapes).",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "reason": {
                            "type": "string",
                          },
                          "ref": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "ref",
                          "reason",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "source_url": {
                      "type": "string",
                    },
                    "started_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "state": {
                      "enum": [
                        "fetching",
                        "indexing",
                        "committing",
                        "committed",
                        "failed",
                      ],
                      "type": "string",
                    },
                    "updated_at": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "id",
                    "state",
                    "source_url",
                    "bytes_received",
                    "refs_imported",
                    "refs_skipped",
                    "started_at",
                    "updated_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get the repository's import",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Fetches every branch and tag of a public git repository over HTTPS (smart HTTP, protocol version 2) into this repository, which must be empty, checking the objects as a push is checked. Runs in the background; follow it with the get operation. Needs write access. The source URL must be a public https URL: private and internal addresses and this deployment's own hostnames are refused.",
        "operationId": "imports.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "url": {
                    "description": "The repository URL as \`git clone\` takes it, e.g. https://github.com/o/r.git.",
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "url",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "bytes_received": {
                      "description": "Pack bytes fetched so far.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "default_branch": {
                      "description": "The branch the source's HEAD names, when it was imported.",
                      "type": "string",
                    },
                    "error": {
                      "type": "string",
                    },
                    "id": {
                      "type": "string",
                    },
                    "refs_imported": {
                      "description": "Branches and tags created, once committed.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "refs_skipped": {
                      "description": "Refs of the source that were not imported, e.g. a name that is not valid UTF-8 (shown with \\xNN escapes).",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "reason": {
                            "type": "string",
                          },
                          "ref": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "ref",
                          "reason",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "source_url": {
                      "type": "string",
                    },
                    "started_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "state": {
                      "enum": [
                        "fetching",
                        "indexing",
                        "committing",
                        "committed",
                        "failed",
                      ],
                      "type": "string",
                    },
                    "updated_at": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "id",
                    "state",
                    "source_url",
                    "bytes_received",
                    "refs_imported",
                    "refs_skipped",
                    "started_at",
                    "updated_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Import a public git repository",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/repos/{owner}/{repo}/issues": {
      "get": {
        "description": "The repository's issues and pull requests (marked with \`pull_request\`), as GitHub's issue listing; \`type\` narrows it to one kind. Each kind is listed only for a caller that may read it: issues need the \`issues:read\` permission, pull requests \`pull_requests:read\`. A listing sorted by \`updated\` may move an item changed between pages.",
        "operationId": "issues.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "open",
              "enum": [
                "open",
                "closed",
                "all",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "description": "Fyrden (as Gitea's): only issues, or only pull requests; both when left out.",
              "enum": [
                "issues",
                "pulls",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "created",
              "enum": [
                "created",
                "updated",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "default": "desc",
              "enum": [
                "asc",
                "desc",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "labels",
            "required": false,
            "schema": {
              "description": "Label names separated by commas, ignoring case: only items with all of them (none when one is not the repository's). A name holding a comma: use \`label_ids\`.",
              "maxLength": 1019,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "label_ids",
            "required": false,
            "schema": {
              "description": "Fyrden: label ids separated by commas (at most 20): only items with all of them. Not with \`labels\`.",
              "pattern": "^[1-9][0-9]{0,14}(?:,[1-9][0-9]{0,14}){0,19}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "assignee",
            "required": false,
            "schema": {
              "description": "A handle: items assigned to that user or agent; \`none\`: unassigned; \`*\`: assigned.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^(?:none|\\*|[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "milestone",
            "required": false,
            "schema": {
              "description": "A milestone's number; \`none\`: in no milestone; \`*\`: in any.",
              "pattern": "^(?:[1-9][0-9]{0,14}|none|\\*)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "creator",
            "required": false,
            "schema": {
              "description": "A handle: items opened by that user or agent (as \`user\` shows them: the user when agents acted for one).",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100. Fyrden: a page also ends once its items pass 1 MiB of JSON (always one item at least), with \`next_cursor\` to go on.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`, with the same filters.",
              "maxLength": 400,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "issues": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "active_lock_reason": {
                            "anyOf": [
                              {
                                "enum": [
                                  "off-topic",
                                  "too heated",
                                  "resolved",
                                  "spam",
                                ],
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "assignee": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "id",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The first of \`assignees\` (GitHub's older field); null for none.",
                          },
                          "assignees": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "id": {
                                  "type": "string",
                                },
                              },
                              "required": [
