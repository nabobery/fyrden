                          "status",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "size": {
                      "description": "The pack's length in bytes.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "state": {
                      "description": "receiving: parts may be uploaded; indexing: completing (call complete again); committed or rejected: done.",
                      "enum": [
                        "receiving",
                        "indexing",
                        "committed",
                        "rejected",
                        "expired",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "state",
                    "size",
                    "part_size",
                    "part_count",
                    "parts_received",
