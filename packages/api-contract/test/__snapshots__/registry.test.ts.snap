    "/repos/{owner}/{repo}/forks": {
      "get": {
        "description": "Lists the forks of a repository that the caller owns, oldest first. Forks owned by other accounts are not listed.",
        "operationId": "repos.forks.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The repository's owner handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "repos": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "default_branch": {
                            "type": "string",
                          },
                          "description": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "expires_at": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "When it is deleted (Unix time in milliseconds); null to keep it.",
                          },
                          "fork": {
                            "description": "Whether the repository was forked from another.",
                            "type": "boolean",
                          },
                          "full_name": {
                            "description": "owner/name",
                            "type": "string",
                          },
                          "id": {
                            "description": "Immutable repository id (rep_ prefix).",
                            "type": "string",
                          },
                          "is_template": {
                            "description": "Whether new repositories can be generated from it (\`/generate\`).",
                            "type": "boolean",
                          },
                          "name": {
                            "type": "string",
                          },
                          "owner": {
                            "description": "The owner's handle.",
                            "type": "string",
                          },
                          "parent_id": {
                            "description": "The id of the repository it was forked from.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "stargazers_count": {
                            "description": "How many users starred it.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "visibility": {
                            "enum": [
                              "public",
                              "internal",
                              "private",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "owner",
                          "name",
                          "full_name",
                          "visibility",
                          "description",
                          "default_branch",
                          "fork",
                          "is_template",
                          "stargazers_count",
                          "expires_at",
                          "parent_id",
                          "created_at",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "repos",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List forks",
        "x-fyrden-permission": "metadata:read",
        "x-fyrden-principals": [
