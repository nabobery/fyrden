                      "type": "boolean",
                    },
                    "path": {
                      "type": "string",
                    },
                    "performed_via_agents": {
                      "description": "Fyrden: the agents that wrote it for \`user\`, the acting one first; empty if none.",
                      "items": {
                        "type": "string",
