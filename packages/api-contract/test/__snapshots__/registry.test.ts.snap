    "/repos/{owner}/{repo}/pulls/{pull_number}/update-branch": {
      "put": {
        "description": "Merges the base branch's tip into an open pull request's head branch (a merge commit made and signed by the server; parents: the head, then the base tip). Write access; the head branch's rulesets apply. A head branch in a fork is written there: the caller needs write access to the fork, or the pull request's \`maintainer_can_modify\` (the author still writing the fork); that repository's rulesets apply. Refused (422) when it conflicts (resolve the conflicts instead) or when the head already contains the base tip; refused (409) when \`expected_head_sha\` is not the head. Done before the answer, which is GitHub's 202.",
        "operationId": "pulls.branch.update",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "expected_head_sha": {
                    "description": "The head the pull request must be at.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                    "sha": {
                      "description": "Fyrden: the merge commit the head branch now points at.",
                      "type": "string",
                    },
                    "url": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                    "url",
                    "sha",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Accepted",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Update a pull request branch",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
