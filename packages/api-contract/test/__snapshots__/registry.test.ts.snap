                    "minimum": 1,
                    "type": "integer",
                  },
                  "maintainer_can_modify": {
                    "description": "The author only: let the base's maintainers change a head branch in a fork.",
                    "type": "boolean",
                  },
                  "state": {
                    "enum": [
                      "open",
                      "closed",
                    ],
                    "type": "string",
                  },
                  "title": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
