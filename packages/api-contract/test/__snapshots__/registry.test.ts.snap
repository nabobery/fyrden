          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "tokens": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "expires_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "grant_id": {
                            "description": "For a git token an agent minted acting for you: the grant it acts under.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "id": {
                            "description": "Token id (tok_ prefix).",
                            "type": "string",
                          },
                          "last_used_at": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "repositories": {
                            "anyOf": [
                              {
                                "items": {
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Repository ids it is limited to; null for every one its holder can reach.",
                          },
                          "revoked": {
                            "type": "boolean",
                          },
                          "scopes": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "type": {
                            "enum": [
                              "pat",
                              "git",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "type",
                          "scopes",
                          "repositories",
                          "created_at",
                          "expires_at",
                          "last_used_at",
                          "revoked",
                          "grant_id",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "tokens",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List your tokens",
        "x-fyrden-permission": "tokens:read",
        "x-fyrden-principals": [
          "user",
        ],
      },
      "post": {
        "description": "Mints a personal access token (\`pat\`) or a git token (\`git\`, for clone, fetch and push) for you, never wider than the token or session making it, and returns it once.",
        "operationId": "users.tokens.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "expires_in_days": {
                    "default": 30,
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "scopes": {
                    "default": [],
                    "description": "Permissions it is limited to (and what they imply). Empty: your token's.",
                    "items": {
                      "enum": [
                        "instance:admin",
                        "repos:create",
                        "members:read",
                        "members:write",
                        "starring:read",
                        "starring:write",
                        "ssh_signing_keys:read",
                        "ssh_signing_keys:write",
                        "tokens:read",
                        "tokens:write",
                        "agents:read",
                        "agents:write",
                        "grants:read",
                        "grants:write",
                        "metadata:read",
                        "contents:read",
                        "contents:write",
                        "pull_requests:read",
                        "pull_requests:write",
                        "issues:read",
                        "issues:write",
                        "administration:write",
                        "repository_hooks:read",
                        "repository_hooks:write",
                      ],
                      "type": "string",
                    },
                    "maxItems": 32,
                    "type": "array",
                  },
                  "type": {
                    "default": "pat",
                    "enum": [
                      "pat",
                      "git",
                    ],
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "expires_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "id": {
                      "type": "string",
                    },
                    "scopes": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "token": {
                      "description": "The token. Shown once and never stored.",
                      "type": "string",
                    },
                    "type": {
                      "enum": [
                        "pat",
                        "git",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "token",
                    "type",
                    "scopes",
                    "expires_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Create a token",
        "x-fyrden-permission": "tokens:write",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/user/tokens/{token_id}": {
      "delete": {
        "description": "Revokes one of your tokens: it stops working at once for writes (within 30 seconds for reads).",
        "operationId": "users.tokens.revoke",
        "parameters": [
          {
            "in": "path",
            "name": "token_id",
            "required": true,
            "schema": {
              "description": "The token's id.",
              "pattern": "^tok_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                    },
                    "revoked": {
                      "const": true,
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "id",
                    "revoked",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Revoke a token",
        "x-fyrden-permission": "tokens:write",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/users/{username}/suspended": {
      "delete": {
        "description": "Lifts a user's suspension: they can sign in again, and their tokens and their agents' work again (sessions and OAuth tokens revoked by the suspension stay revoked). Unsuspending a user who is not suspended changes nothing. Instance administrators only.",
        "operationId": "admin.users.unsuspend",
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "maxLength": 200,
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "204": {
            "description": "No Content",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Unsuspend a user",
        "x-fyrden-permission": "instance:admin",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
      "put": {
        "description": "Suspends a user, as GitHub Enterprise does: the user can no longer sign in, and none of their tokens, nor those of the agents they own, work while suspended; their sessions and OAuth tokens are revoked for good. Their repositories stay available to their collaborators. Suspending a suspended user changes nothing. Instance administrators only; not yourself, nor the last active administrator.",
        "operationId": "admin.users.suspend",
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "maxLength": 200,
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "204": {
            "description": "No Content",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Suspend a user",
        "x-fyrden-permission": "instance:admin",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
  },
}
