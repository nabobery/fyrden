    "/repos/{owner}/{repo}/pulls/comments/{comment_id}": {
      "delete": {
        "description": "Deletes a diff comment; its thread goes with its last comment. Its author may delete its own; write access and above, anyone's.",
        "operationId": "pulls.comments.delete",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
