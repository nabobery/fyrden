    "/repos/{owner}/{repo}/commits/{ref}": {
      "get": {
        "description": "One commit, named by its SHA or by a branch or tag.",
        "operationId": "repos.commits.get",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "ref",
            "required": true,
            "schema": {
              "description": "A branch, a tag, a full ref name (\`refs/...\`) or a full commit SHA.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "commit": {
                      "additionalProperties": false,
                      "properties": {
                        "author": {
                          "additionalProperties": false,
                          "properties": {
                            "date": {
                              "description": "ISO 8601, UTC.",
                              "type": "string",
                            },
                            "email": {
                              "type": "string",
                            },
                            "name": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "name",
                            "email",
                            "date",
                          ],
                          "type": "object",
                        },
                        "committer": {
                          "additionalProperties": false,
                          "properties": {
                            "date": {
                              "description": "ISO 8601, UTC.",
                              "type": "string",
                            },
                            "email": {
                              "type": "string",
                            },
                            "name": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "name",
                            "email",
                            "date",
                          ],
                          "type": "object",
                        },
                        "message": {
                          "type": "string",
                        },
                        "tree": {
                          "additionalProperties": false,
                          "properties": {
                            "sha": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "sha",
                          ],
                          "type": "object",
                        },
                        "verification": {
                          "additionalProperties": false,
                          "description": "Whether the commit is signed with a key Fyrden knows: the platform's key for commits it made (file writes, generated repositories), or a key a user added for commits whose committer is that user's no-reply address.",
                          "properties": {
                            "payload": {
                              "description": "What the signature covers: the commit without it.",
                              "type": [
                                "string",
                                "null",
                              ],
                            },
                            "reason": {
                              "description": "\`valid\` (signed by a known key), \`unsigned\`, \`unknown_key\`, \`bad_email\` (a user's key, on a commit whose committer is not that user), \`invalid\`, \`malformed_signature\` or \`unknown_signature_type\`, as GitHub names them.",
                              "type": "string",
                            },
                            "signature": {
                              "description": "The armored signature.",
                              "type": [
                                "string",
                                "null",
                              ],
                            },
                            "verified": {
                              "type": "boolean",
                            },
                            "verified_at": {
                              "type": [
                                "string",
                                "null",
                              ],
                            },
                          },
                          "required": [
                            "verified",
                            "reason",
                            "signature",
                            "payload",
                            "verified_at",
                          ],
                          "type": "object",
                        },
                      },
                      "required": [
                        "message",
                        "author",
                        "committer",
                        "tree",
                        "verification",
                      ],
                      "type": "object",
                    },
                    "parents": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "sha": {
                            "description": "A full commit SHA (40 hex digits).",
                            "type": "string",
                          },
                        },
                        "required": [
                          "sha",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "sha": {
                      "description": "A full commit SHA (40 hex digits).",
                      "type": "string",
                    },
                  },
                  "required": [
                    "sha",
                    "commit",
                    "parents",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get a commit",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/repos/{owner}/{repo}/compare/{basehead}": {
      "get": {
        "description": "Compares \`base...head\` (branches, tags or SHAs): how far head is ahead of and behind base, their merge base, and the commits in head and not in base, oldest first (the newest 100). File differences are not included.",
