            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "1-100 letters, digits, '.', '_' and '-'; not '.' or '..'; must not end in '.git'. Unique per owner, ignoring case.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "default_branch": {
                      "type": "string",
                    },
                    "description": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "expires_at": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "When it is deleted (Unix time in milliseconds); null to keep it.",
                    },
                    "fork": {
                      "description": "Whether the repository was forked from another.",
                      "type": "boolean",
                    },
                    "full_name": {
                      "description": "owner/name",
                      "type": "string",
                    },
                    "id": {
                      "description": "Immutable repository id (rep_ prefix).",
                      "type": "string",
                    },
                    "is_template": {
                      "description": "Whether new repositories can be generated from it (\`/generate\`).",
                      "type": "boolean",
                    },
                    "name": {
                      "type": "string",
                    },
                    "owner": {
                      "description": "The owner's handle.",
                      "type": "string",
                    },
                    "owner_type": {
                      "description": "Fyrden (GitHub's \`owner.type\`): whether a user or an organization owns it (only an organization's repository takes team reviewers). Absent from a repository just created or forked.",
                      "enum": [
                        "User",
                        "Organization",
                      ],
                      "type": "string",
                    },
                    "parent_id": {
                      "description": "The id of the repository it was forked from.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "permissions": {
                      "additionalProperties": false,
                      "description": "Only from \`GET /repos/{owner}/{repo}\`: what the caller's role there allows, as GitHub's (an agent's never above its owner's); what its token may do is decided by each operation.",
                      "properties": {
                        "admin": {
                          "type": "boolean",
                        },
                        "maintain": {
                          "type": "boolean",
                        },
                        "pull": {
                          "type": "boolean",
                        },
                        "push": {
                          "type": "boolean",
                        },
                        "triage": {
                          "type": "boolean",
                        },
                      },
                      "required": [
                        "admin",
                        "maintain",
                        "push",
                        "triage",
                        "pull",
                      ],
                      "type": "object",
                    },
                    "source_id": {
                      "description": "Only from \`GET /repos/{owner}/{repo}\`: for a fork, the id of the repository its fork network grew from (GitHub's \`source\`), when you can see it; null otherwise.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "stargazers_count": {
                      "description": "How many users starred it.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "visibility": {
                      "enum": [
                        "public",
                        "internal",
                        "private",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "owner",
                    "name",
                    "full_name",
                    "visibility",
                    "description",
                    "default_branch",
                    "fork",
                    "is_template",
                    "stargazers_count",
                    "expires_at",
                    "parent_id",
                    "created_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
