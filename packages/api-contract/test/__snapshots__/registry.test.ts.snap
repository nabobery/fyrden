                              "+1",
                              "-1",
                              "laugh",
                              "confused",
                              "heart",
                              "hooray",
                              "rocket",
                              "eyes",
                            ],
                            "type": "object",
                          },
                          "resolved": {
                            "description": "Fyrden: its thread is resolved.",
                            "type": "boolean",
                          },
                          "side": {
                            "description": "\`RIGHT\`: the head's file; \`LEFT\`: the merge base's.",
                            "enum": [
                              "LEFT",
                              "RIGHT",
                            ],
                            "type": "string",
                          },
                          "start_line": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The first line, for a range.",
