            },
          },
          {
            "in": "path",
            "name": "hook_id",
            "required": true,
            "schema": {
              "description": "The webhook's id.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "path",
            "name": "delivery_id",
            "required": true,
            "schema": {
              "pattern": "^msg_[0-9a-f]{32}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "attempts": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "delivered_at": {
                      "type": "string",
                    },
                    "event": {
                      "type": "string",
                    },
                    "id": {
                      "description": "The delivery's \`webhook-id\` (the same on every attempt).",
                      "type": "string",
                    },
                    "next_attempt_at": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "reason": {
                      "description": "Why it failed, was cancelled or dropped.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "state": {
                      "enum": [
                        "pending",
                        "done",
                        "failed",
                        "cancelled",
                        "dropped",
                      ],
                      "type": "string",
                    },
                    "status_code": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "The last attempt's response status.",
                    },
                  },
                  "required": [
                    "id",
                    "event",
                    "action",
                    "state",
                    "reason",
                    "status_code",
                    "attempts",
                    "delivered_at",
                    "next_attempt_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Accepted",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
