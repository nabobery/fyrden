            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "open",
              "enum": [
                "open",
                "closed",
                "all",
