                        {
                          "type": "null",
                        },
                      ],
                      "description": "Who merged it (the user, when agents acted for one).",
                    },
                    "milestone": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "closed_at": {
                              "anyOf": [
                                {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer",
                                },
                                {
                                  "type": "null",
                                },
                              ],
                              "description": "Unix time in milliseconds.",
                            },
                            "closed_issues": {
                              "description": "Closed issues, and closed or merged pull requests, of the kinds the caller reads.",
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
                            },
                            "created_at": {
                              "description": "Unix time in milliseconds.",
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
                            },
                            "creator": {
                              "additionalProperties": false,
                              "properties": {
                                "id": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "id",
                              ],
                              "type": "object",
                            },
                            "description": {
                              "type": [
                                "string",
                                "null",
                              ],
                            },
                            "due_on": {
                              "anyOf": [
                                {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer",
                                },
                                {
                                  "type": "null",
                                },
                              ],
                              "description": "Unix time in milliseconds.",
                            },
                            "id": {
                              "description": "Fyrden: the number again (milestones have no separate id space).",
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
                            },
                            "number": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
                            },
                            "open_issues": {
                              "description": "Open issues and pull requests in it, of the kinds the caller reads.",
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
