    "/repos/{owner}/{repo}/contents": {
      "get": {
        "description": "The root directory's entries at a branch, tag or commit, a page at a time.",
        "operationId": "repos.contents.root",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "ref",
            "required": false,
            "schema": {
              "description": "A branch, a tag or a full commit SHA; the default branch when absent.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 1000,
              "description": "Directory entries per page, 1-1000.",
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 64,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "entries": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "mode": {
                                "description": "Git's mode in octal: \`100644\`, \`100755\`, \`120000\`, \`040000\`, \`160000\`.",
                                "type": "string",
                              },
                              "name": {
                                "type": "string",
                              },
                              "path": {
                                "type": "string",
                              },
                              "sha": {
                                "description": "A full object SHA (40 hex digits).",
                                "type": "string",
                              },
                              "type": {
                                "enum": [
                                  "file",
                                  "dir",
                                  "symlink",
                                  "submodule",
                                ],
                                "type": "string",
                              },
                            },
                            "required": [
                              "type",
                              "name",
                              "path",
                              "sha",
                              "mode",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "next_cursor": {
                          "description": "Pass as \`cursor\` for the next page of entries; null on the last page.",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "type": {
                          "const": "dir",
                          "type": "string",
                        },
                      },
                      "required": [
                        "type",
                        "path",
                        "sha",
                        "entries",
                        "next_cursor",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "content": {
                          "description": "The file's bytes, base64; empty when \`encoding\` is \`none\`.",
                          "type": "string",
                        },
                        "download_url": {
                          "description": "The raw bytes at the same commit (the same token works).",
                          "type": "string",
                        },
                        "encoding": {
                          "description": "\`none\` when the file is too large to include.",
                          "enum": [
                            "base64",
                            "none",
                          ],
                          "type": "string",
                        },
                        "mode": {
                          "description": "Git's mode in octal: \`100644\`, \`100755\`, \`120000\`, \`040000\`, \`160000\`.",
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "size": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "type": {
                          "const": "file",
                          "type": "string",
                        },
                      },
                      "required": [
                        "type",
                        "path",
                        "name",
                        "sha",
                        "mode",
                        "size",
                        "encoding",
                        "content",
                        "download_url",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "content": {
                          "description": "The target's exact bytes, base64.",
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "size": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "target": {
                          "description": "The target as UTF-8 (other bytes are replaced; see \`content\`).",
                          "type": "string",
                        },
                        "type": {
                          "const": "symlink",
                          "type": "string",
                        },
                      },
                      "required": [
                        "type",
                        "path",
                        "name",
                        "sha",
                        "size",
                        "target",
                        "content",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "type": {
                          "const": "submodule",
                          "type": "string",
                        },
                      },
                      "required": [
                        "type",
                        "path",
                        "name",
                        "sha",
                      ],
                      "type": "object",
                    },
                  ],
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List the repository's root directory",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/repos/{owner}/{repo}/contents/{path}": {
      "delete": {
        "description": "Deletes one file as a new commit on a branch. \`sha\` is the file's current blob SHA; fails with 409 when the file or the branch changed meanwhile.",
        "operationId": "repos.contents.delete",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "description": "A path from the repository's root, \`a/b/c.txt\`.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "author": {
                    "description": "The commit's author; the authenticated principal when absent (always the committer).",
                    "properties": {
                      "email": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                      "name": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "name",
                      "email",
                    ],
                    "type": "object",
                  },
                  "branch": {
                    "description": "The branch to commit to; the default branch when absent.",
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string",
                  },
                  "message": {
                    "description": "The commit message.",
                    "maxLength": 65536,
                    "minLength": 1,
                    "type": "string",
                  },
                  "sha": {
                    "description": "The file's current blob SHA.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                },
                "required": [
                  "message",
                  "sha",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "commit": {
                      "additionalProperties": false,
                      "properties": {
                        "commit": {
                          "additionalProperties": false,
                          "properties": {
                            "author": {
                              "additionalProperties": false,
                              "properties": {
                                "date": {
                                  "description": "ISO 8601, UTC.",
                                  "type": "string",
                                },
                                "email": {
                                  "type": "string",
                                },
                                "name": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "name",
                                "email",
                                "date",
                              ],
                              "type": "object",
                            },
                            "committer": {
                              "additionalProperties": false,
                              "properties": {
                                "date": {
                                  "description": "ISO 8601, UTC.",
                                  "type": "string",
                                },
                                "email": {
                                  "type": "string",
                                },
                                "name": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "name",
                                "email",
                                "date",
                              ],
                              "type": "object",
                            },
                            "message": {
                              "type": "string",
                            },
                            "tree": {
                              "additionalProperties": false,
                              "properties": {
                                "sha": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "sha",
                              ],
                              "type": "object",
                            },
                            "verification": {
                              "additionalProperties": false,
                              "description": "Whether the commit is signed with a key Fyrden knows: the platform's key for commits it made (file writes, generated repositories).",
                              "properties": {
                                "payload": {
                                  "description": "What the signature covers: the commit without it.",
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                                "reason": {
                                  "description": "\`valid\` (signed by a known key), \`unsigned\`, \`unknown_key\`, \`invalid\`, \`malformed_signature\` or \`unknown_signature_type\`, as GitHub names them.",
                                  "type": "string",
                                },
                                "signature": {
                                  "description": "The armored signature.",
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                                "verified": {
                                  "type": "boolean",
                                },
                                "verified_at": {
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                              },
                              "required": [
                                "verified",
                                "reason",
                                "signature",
                                "payload",
                                "verified_at",
                              ],
                              "type": "object",
                            },
                          },
                          "required": [
                            "message",
                            "author",
                            "committer",
                            "tree",
                            "verification",
                          ],
                          "type": "object",
                        },
                        "parents": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "sha": {
                                "description": "A full commit SHA (40 hex digits).",
                                "type": "string",
                              },
                            },
                            "required": [
                              "sha",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "sha": {
                          "description": "A full commit SHA (40 hex digits).",
                          "type": "string",
                        },
                      },
                      "required": [
                        "sha",
                        "commit",
                        "parents",
                      ],
                      "type": "object",
                    },
                    "content": {
                      "type": "null",
                    },
                  },
                  "required": [
                    "content",
                    "commit",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Delete a file",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
