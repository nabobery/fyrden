      "patch": {
        "description": "Changes the title or body, closes or reopens it, marks it a duplicate, or sets its labels, assignees or milestone; fields left out are kept, and all of it happens or none. The author may edit, close and reopen its own issue; on anyone else's, triage closes and reopens, and write edits. Marking a duplicate (\`state_reason: duplicate\` with \`duplicate_of\`) and setting labels, assignees or the milestone take triage, the author's own issue included. As GitHub's, \`state_reason\` alone changes nothing unless the state changes, except moving a closed issue to or from \`duplicate\`. A pull request's number takes only labels, assignees and milestone (with \`pull_requests:write\`); its title, body and state change through \`pulls.update\`.",
        "operationId": "issues.update",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
