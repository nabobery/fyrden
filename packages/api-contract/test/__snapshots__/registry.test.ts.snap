    "/repos/{owner}/{repo}/archives/{format}": {
      "get": {
        "description": "Prepares the files of a branch, tag or commit as a tar.gz or zip archive and gives its link (\`download_url\`, GitHub's tarball or zipball route; the same token works). A large archive is built in the background: \`state\` is \`building\` until it is \`ready\`; ask again, or fetch the link, which answers 202 until then. Archives hold 1 GiB of files at most, each file 24 MiB at most, a zip 65,535 entries.",
        "operationId": "repos.archives.get",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "format",
            "required": true,
            "schema": {
              "enum": [
                "tar.gz",
                "zip",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "ref",
            "required": false,
            "schema": {
              "description": "A branch, a tag or a full commit SHA; the default branch when absent.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "commit": {
                      "description": "The commit archived.",
                      "type": "string",
                    },
                    "download_url": {
                      "type": "string",
                    },
                    "size": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "The archive's size in bytes, once ready.",
                    },
                    "state": {
                      "enum": [
                        "ready",
                        "building",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "state",
                    "commit",
                    "size",
                    "download_url",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get an archive link",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
