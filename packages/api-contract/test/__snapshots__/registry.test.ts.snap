                            "type": "string",
                          },
                          "parent_id": {
                            "description": "The id of the repository it was forked from.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "source_id": {
                            "description": "Only from \`GET /repos/{owner}/{repo}\`: for a fork, the id of the repository its fork network grew from (GitHub's \`source\`), when you can see it; null otherwise.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "stargazers_count": {
                            "description": "How many users starred it.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "visibility": {
                            "enum": [
