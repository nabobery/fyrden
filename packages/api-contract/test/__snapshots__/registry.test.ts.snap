                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "reason": {
                            "type": "string",
                          },
                          "ref": {
                            "type": "string",
                          },
                          "status": {
                            "enum": [
                              "ok",
                              "rejected",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "ref",
                          "status",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "size": {
                      "description": "The pack's length in bytes.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "state": {
                      "description": "receiving: parts may be uploaded; indexing: completing (call complete again); committed or rejected: done.",
                      "enum": [
                        "receiving",
                        "indexing",
                        "committed",
                        "rejected",
                        "expired",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "state",
                    "size",
                    "part_size",
                    "part_count",
                    "parts_received",
                    "parts_url",
                    "expires_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Complete a chunked pack upload",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/repos/{template_owner}/{template_repo}/generate": {
      "post": {
        "description": "Creates a private repository whose first commit (on \`main\`) holds the files of the template's default branch, with their modes, symlinks and submodule links (at most 2,000 files and directories, 8 MiB in all). Unlike a fork it starts its own history and shares nothing with the template. The template must be marked \`is_template\` and readable by the caller; \`owner\` may be the caller or an organization it may create repositories in, where it can write. The token needs \`contents:write\` as well, without a repository list. Answers 422 \`not_a_template\`, or 422 \`template_too_large\` past the bounds; on a failure no repository is left.",
        "operationId": "repos.generate",
        "parameters": [
          {
            "in": "path",
            "name": "template_owner",
            "required": true,
            "schema": {
              "description": "The template's owner handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "template_repo",
            "required": true,
            "schema": {
              "description": "The template's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "expires_at": {
                    "description": "Delete the repository at this time (Unix milliseconds): in the future, at most one year ahead. Every 5 minutes, expired repositories are marked for deletion (a bounded number per run, oldest expiry first) and deleted like any other.",
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer",
                  },
                  "name": {
                    "description": "The new repository's name.",
                    "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                    "type": "string",
                  },
                  "owner": {
                    "description": "Who owns the new repository: the caller (default) or an organization.",
                    "maxLength": 39,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "default_branch": {
                      "type": "string",
                    },
                    "description": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "expires_at": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "When it is deleted (Unix time in milliseconds); null to keep it.",
                    },
                    "fork": {
                      "description": "Whether the repository was forked from another.",
                      "type": "boolean",
                    },
                    "full_name": {
                      "description": "owner/name",
                      "type": "string",
                    },
                    "id": {
                      "description": "Immutable repository id (rep_ prefix).",
                      "type": "string",
                    },
                    "is_template": {
                      "description": "Whether new repositories can be generated from it (\`/generate\`).",
                      "type": "boolean",
                    },
                    "name": {
                      "type": "string",
                    },
                    "owner": {
                      "description": "The owner's handle.",
                      "type": "string",
                    },
                    "parent_id": {
                      "description": "The id of the repository it was forked from.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "source_id": {
                      "description": "Only from \`GET /repos/{owner}/{repo}\`: for a fork, the id of the repository its fork network grew from (GitHub's \`source\`), when you can see it; null otherwise.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "stargazers_count": {
                      "description": "How many users starred it.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "visibility": {
                      "enum": [
                        "public",
                        "internal",
                        "private",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "owner",
                    "name",
                    "full_name",
                    "visibility",
                    "description",
                    "default_branch",
                    "fork",
                    "is_template",
                    "stargazers_count",
                    "expires_at",
                    "parent_id",
                    "created_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Create a repository from a template",
        "x-fyrden-permission": "repos:create",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/user": {
      "get": {
        "description": "Returns the principal and token that authenticated this request, and for a delegated token the agents acting for the principal.",
        "operationId": "meta.whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "act": {
                      "description": "For a delegated token, the agents acting for this principal, the current one first (an RFC 8693 \`act\` chain); empty otherwise.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "handle": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "id": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "handle",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "handle": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "id": {
                      "description": "Principal id (usr_, org_, agt_ or ins_ prefix): whose rights the token uses.",
                      "type": "string",
                    },
                    "is_instance_admin": {
                      "type": "boolean",
                    },
                    "token": {
                      "additionalProperties": false,
                      "properties": {
                        "expires_at": {
                          "description": "Unix time in milliseconds.",
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "grant_id": {
                          "description": "The delegation grant a delegated token was issued under; null otherwise.",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "id": {
                          "type": "string",
                        },
                        "scopes": {
                          "items": {
                            "type": "string",
                          },
                          "type": "array",
                        },
                        "type": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "type",
                        "scopes",
                        "expires_at",
                        "grant_id",
                      ],
                      "type": "object",
                    },
                    "type": {
                      "enum": [
                        "user",
                        "org",
                        "agent",
                        "installation",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
