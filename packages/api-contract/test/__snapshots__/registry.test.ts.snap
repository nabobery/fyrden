                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "line": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "The line commented on; null once \`outdated\`.",
                    },
                    "original_commit_id": {
                      "type": "string",
                    },
                    "original_line": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "outdated": {
