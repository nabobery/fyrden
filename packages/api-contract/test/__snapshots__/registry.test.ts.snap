    "/user/starred/{owner}/{repo}": {
      "delete": {
        "description": "Takes the caller's star off a repository it can read. Unstarring one not starred changes nothing.",
        "operationId": "stars.delete",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The repository's owner handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "repo": {
                      "description": "owner/name",
                      "type": "string",
                    },
                    "starred": {
                      "const": false,
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "repo",
                    "starred",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Unstar a repository",
        "x-fyrden-permission": "starring:write",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
      "put": {
        "description": "Stars a repository the caller can read. Starring one already starred changes nothing. The token also needs \`metadata:read\` for the repository.",
        "operationId": "stars.put",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The repository's owner handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "repo": {
                      "description": "owner/name",
                      "type": "string",
                    },
                    "starred": {
                      "const": true,
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "repo",
                    "starred",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Star a repository",
        "x-fyrden-permission": "starring:write",
        "x-fyrden-principals": [
