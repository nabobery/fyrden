    "/repos/{owner}/{repo}/hooks/{hook_id}/deliveries/{delivery_id}/attempts": {
      "post": {
        "description": "Sends a finished delivery (\`done\` or \`failed\`) once more: its original body, the same \`webhook-id\`, signed with the hook's current secrets at a fresh timestamp. One attempt, not retried; queued, the answer comes before it is made. Refused while it is pending (409 \`delivery_pending\`), while a 410 from its receiver is turning the hook off (409 \`hook_being_disabled\`), for a delivery that was cancelled or dropped (422 \`not_redeliverable\`), once its body is gone (422 \`payload_gone\`), once it has made 50 attempts (422 \`too_many_attempts\`), for an inactive hook (422 \`hook_inactive\`), and while the hook has 1,000 deliveries waiting (409 \`too_many_outstanding\`). Administrators only.",
        "operationId": "repos.hooks.deliveries.redeliver",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
