      "post": {
        "description": "Comments on lines of a file in a pull request's diff, starting a thread; with \`in_reply_to\`, replies in that comment's thread instead (no anchor then). \`commit_id\` must be a head the pull request has had; \`side\` RIGHT comments on that commit's file, LEFT on the merge base's; the file must have the lines (whether they are part of the diff is not checked). Anyone who can read the repository may comment.",
        "operationId": "pulls.comments.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "maxLength": 65536,
                    "type": "string",
                  },
                  "commit_id": {
                    "description": "The head the lines are of; needed unless replying.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                  "in_reply_to": {
                    "description": "A comment to reply to.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "line": {
                    "description": "The (last) line; needed unless replying.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "path": {
                    "description": "The file; needed unless replying.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string",
                  },
                  "side": {
                    "default": "RIGHT",
                    "enum": [
                      "LEFT",
                      "RIGHT",
                    ],
                    "type": "string",
                  },
                  "start_line": {
                    "description": "The first line, for a range.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "start_side": {
                    "description": "As \`side\`; a range stays on one side.",
                    "enum": [
                      "LEFT",
                      "RIGHT",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "body",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "body": {
                      "type": "string",
                    },
                    "commit_id": {
                      "description": "The head the thread was started on.",
                      "type": "string",
                    },
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "id": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "in_reply_to_id": {
                      "description": "The comment this one answers.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "line": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "The line commented on; null once \`outdated\`.",
                    },
                    "original_commit_id": {
                      "type": "string",
                    },
                    "original_line": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "outdated": {
                      "description": "Fyrden: the diff moved on since: the head moved, or for \`LEFT\` the merge base (the base branch can move it with the head unchanged); the lines are those of \`commit_id\` (for \`LEFT\`, of the merge base then).",
                      "type": "boolean",
                    },
                    "path": {
                      "type": "string",
                    },
                    "performed_via_agents": {
                      "description": "Fyrden: the agents that wrote it for \`user\`, the acting one first; empty if none.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "pull_request_review_id": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Always null: comments are not part of a review yet.",
                    },
                    "reactions": {
                      "additionalProperties": false,
                      "description": "Its reactions counted by content, as they stand.",
                      "properties": {
                        "+1": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "-1": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "confused": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "eyes": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "heart": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "hooray": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "laugh": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "rocket": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "total_count": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "viewer": {
                          "description": "Fyrden: the caller's own reactions to it (their ids, to take one back), in an issue or pull request read alone (\`issues.get\`, \`pulls.get\`) and in a page of conversation comments; absent elsewhere.",
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "content": {
                                "enum": [
                                  "+1",
