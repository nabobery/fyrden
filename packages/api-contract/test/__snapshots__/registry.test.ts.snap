    "/repos/{owner}/{repo}/pulls/{pull_number}/commits": {
      "get": {
        "description": "The commits a pull request's head has that its base branch does not, oldest first; at most 250 (GitHub's limit). A closed or merged pull request is compared from its base branch as it was when it closed or merged (\`base.sha\`).",
        "operationId": "pulls.commits.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "commits": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "commit": {
                            "additionalProperties": false,
                            "properties": {
                              "author": {
                                "additionalProperties": false,
                                "properties": {
                                  "date": {
                                    "description": "ISO 8601, UTC.",
                                    "type": "string",
                                  },
                                  "email": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "name",
                                  "email",
                                  "date",
                                ],
                                "type": "object",
                              },
                              "committer": {
                                "additionalProperties": false,
                                "properties": {
                                  "date": {
                                    "description": "ISO 8601, UTC.",
                                    "type": "string",
                                  },
                                  "email": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "name",
                                  "email",
                                  "date",
                                ],
                                "type": "object",
                              },
                              "message": {
                                "type": "string",
                              },
                              "tree": {
                                "additionalProperties": false,
                                "properties": {
                                  "sha": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "sha",
                                ],
                                "type": "object",
                              },
                              "verification": {
                                "additionalProperties": false,
                                "description": "Whether the commit is signed with a key Fyrden knows: the platform's key for commits it made (file writes, generated repositories), or a key a user added for commits whose committer is that user's no-reply address.",
                                "properties": {
                                  "payload": {
                                    "description": "What the signature covers: the commit without it.",
                                    "type": [
                                      "string",
                                      "null",
                                    ],
                                  },
                                  "reason": {
                                    "description": "\`valid\` (signed by a known key), \`unsigned\`, \`unknown_key\`, \`bad_email\` (a user's key, on a commit whose committer is not that user), \`invalid\`, \`malformed_signature\` or \`unknown_signature_type\`, as GitHub names them.",
                                    "type": "string",
                                  },
                                  "signature": {
                                    "description": "The armored signature.",
                                    "type": [
                                      "string",
                                      "null",
                                    ],
                                  },
                                  "verified": {
                                    "type": "boolean",
                                  },
                                  "verified_at": {
                                    "type": [
                                      "string",
                                      "null",
                                    ],
                                  },
                                },
                                "required": [
                                  "verified",
                                  "reason",
                                  "signature",
                                  "payload",
                                  "verified_at",
                                ],
                                "type": "object",
                              },
                            },
                            "required": [
                              "message",
                              "author",
                              "committer",
                              "tree",
                              "verification",
                            ],
                            "type": "object",
                          },
                          "parents": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "sha": {
                                  "description": "A full commit SHA (40 hex digits).",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "sha",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "sha": {
                            "description": "A full commit SHA (40 hex digits).",
                            "type": "string",
                          },
                        },
                        "required": [
                          "sha",
                          "commit",
                          "parents",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                  },
                  "required": [
                    "commits",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List pull request commits",
        "x-fyrden-permission": "pull_requests:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/repos/{owner}/{repo}/pulls/{pull_number}/conflicts": {
      "get": {
        "description": "Fyrden: the conflicts of merging the base branch's tip into an open pull request's head (none when they merge cleanly). Files whose lines conflict in text (\`content\`, \`add_add\`) are \`editable\`: their merged content is given with git's conflict markers, the head's side first, each side labelled with its branch (\`<<<<<<< <head branch>\`, \`=======\`, \`>>>>>>> <base branch>\`), up to 50 files and 4 MiB in all. Any other conflict (a file deleted on one side, a mode, a symlink, a submodule, a binary or too large file, a file and a directory; renames are not followed) is listed but needs a merge made by hand. Resolve them with \`conflict_snapshot\`, which names the base tip and head they were read at. A head in a fork is read as the base last imported it.",
        "operationId": "pulls.conflicts.get",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "base_sha": {
                      "type": "string",
                    },
                    "conflict_snapshot": {
                      "description": "Names this base tip and head, for the resolution.",
                      "type": "string",
                    },
                    "files": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "conflicts": {
                            "description": "Conflicts marked in \`content\`.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "content": {
                            "description": "An editable file merged, with conflict markers; null otherwise.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "editable": {
                            "type": "boolean",
                          },
                          "kind": {
                            "enum": [
                              "content",
                              "add_add",
                              "modify_delete",
                              "file_directory",
                              "mode",
                              "symlink",
                              "submodule",
                              "binary",
                              "too_large",
                            ],
                            "type": "string",
                          },
                          "path": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "path",
                          "kind",
                          "editable",
                          "content",
                          "conflicts",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "head_sha": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "base_sha",
                    "head_sha",
                    "conflict_snapshot",
                    "files",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get a pull request's conflicts",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Fyrden: merges the base branch's tip into the head branch with the given contents for every file whose lines conflict, as one merge commit (parents: the head, then the base tip) made and signed by the server. Write access; the head branch's rulesets apply. A head branch in a fork is written there: the caller needs write access to the fork, or the pull request's \`maintainer_can_modify\` (the author still writing the fork); that repository's rulesets apply. Refused when either branch moved since the conflicts were read (409 \`head_moved\`, \`base_moved\`), when a conflict cannot be resolved here (422 \`not_editable\`), when a conflicted file is missing (422 \`unresolved\`), or when a given file has no conflict (422 \`not_conflicted\`). Contents that still hold conflict markers are accepted and named in \`markers\`.",
        "operationId": "pulls.conflicts.resolve",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "commit_message": {
                    "description": "By default \`Merge branch '<base>' into <head>\`.",
                    "maxLength": 65536,
                    "minLength": 1,
                    "type": "string",
                  },
                  "conflict_snapshot": {
                    "description": "From reading the conflicts.",
                    "pattern": "^[0-9a-f]{80}$",
                    "type": "string",
                  },
                  "files": {
                    "description": "The resolved content of each file whose lines conflict.",
                    "items": {
                      "properties": {
                        "content": {
                          "description": "The file's resolved content (UTF-8).",
                          "maxLength": 1048576,
                          "type": "string",
                        },
                        "path": {
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "path",
                        "content",
                      ],
                      "type": "object",
                    },
                    "maxItems": 50,
                    "type": "array",
                  },
                },
                "required": [
                  "conflict_snapshot",
                  "files",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "markers": {
                      "description": "Resolved files that still contain conflict markers (accepted as given).",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "sha": {
                      "description": "The merge commit the head branch now points at.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "sha",
                    "markers",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Resolve a pull request's conflicts",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/repos/{owner}/{repo}/pulls/{pull_number}/files": {
      "get": {
        "description": "The files a pull request changes, compared from the merge base of its base branch and head to its head (as GitHub's three-dot comparison), in path order, with each file's patch. At most 3,000 files are listed; renames with unchanged content are found. A closed or merged pull request is compared from its base branch as it was when it closed or merged (\`base.sha\`), whatever the branch does after. Pages keep the comparison they started with: the cursor carries \`merge_base_sha\` and \`head_sha\`.",
        "operationId": "pulls.files.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 400,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "files": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "additions": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "approximate": {
                            "description": "Fyrden: true when the hunks are right but not the shortest (comparing cost too much).",
                            "type": "boolean",
                          },
                          "changes": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "deletions": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "filename": {
                            "type": "string",
                          },
                          "patch": {
                            "description": "The file's hunks as unified diff text; left out when \`patch_omitted\` says why.",
                            "type": "string",
                          },
                          "patch_omitted": {
                            "description": "Fyrden: why there is no patch: a binary file, a side over 1 MiB (or too many lines), a patch over 64 KiB, a submodule, or this page's read budget (ask for a smaller page).",
                            "enum": [
                              "binary",
                              "too_large",
                              "patch_too_large",
                              "submodule",
                              "budget",
                            ],
                            "type": "string",
                          },
                          "previous_filename": {
                            "description": "For a renamed file, where it was.",
                            "type": "string",
                          },
                          "sha": {
                            "description": "The file's blob on the head side (the removed blob for a removal).",
                            "type": "string",
                          },
                          "status": {
                            "description": "\`changed\` is a change of mode or kind only.",
                            "enum": [
                              "added",
                              "removed",
                              "modified",
                              "renamed",
                              "changed",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "sha",
                          "filename",
                          "status",
                          "additions",
                          "deletions",
                          "changes",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "head_sha": {
                      "type": "string",
                    },
                    "merge_base_sha": {
                      "type": "string",
                    },
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "truncated": {
                      "description": "More than 3,000 files changed: the listing stops there.",
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "files",
                    "merge_base_sha",
                    "head_sha",
                    "truncated",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List pull request files",
        "x-fyrden-permission": "pull_requests:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/repos/{owner}/{repo}/pulls/{pull_number}/merge": {
      "put": {
        "description": "Merges an open pull request that is not a draft into its base branch: \`merge\` makes a merge commit of the base branch's tip and the head, \`squash\` one commit on the base branch with the head's changes (by the pull request's author). The commit is made and signed by the server; the base branch's rulesets apply, with the pull request's reviews and last push. Refused (405) on conflicts, or when the base branch moved while merging; refused (409) when \`sha\` is not the head. \`rebase\` replays the pull request's commits (at most 250, none a merge commit) one by one onto the base branch's tip and moves the branch to the last: their authors, author dates and messages are kept, the server is their committer and signs each. Empty commits follow \`git rebase\`: a commit empty from the start is kept, one whose changes are already in the base is dropped; a commit the base changed further, or a rename in the base of a file the pull request edits, is a conflict. A rebase too long for one request answers 409 \`merge_in_progress\` and goes on in the background: send the request again (a finished rebase answers its merge) or watch the pull request.",
        "operationId": "pulls.merge",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "commit_message": {
                    "description": "The commit's message after its title; by default the pull request's title (merge) or body (squash).",
                    "maxLength": 65536,
                    "type": "string",
                  },
                  "commit_title": {
                    "description": "The commit's first line; GitHub's default for the method when left out (\`Merge pull request #n from owner/branch\`, or the title and number).",
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string",
                  },
                  "merge_method": {
                    "default": "merge",
                    "enum": [
                      "merge",
                      "squash",
                      "rebase",
                    ],
                    "type": "string",
                  },
                  "sha": {
                    "description": "The head the pull request must be at: the merge is refused otherwise.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "merged": {
                      "type": "boolean",
                    },
                    "message": {
                      "type": "string",
                    },
                    "sha": {
                      "description": "The commit the base branch now points at.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "sha",
                    "merged",
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Merge a pull request",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/repos/{owner}/{repo}/pulls/{pull_number}/requested_reviewers": {
      "delete": {
        "description": "Withdraws review requests; reviewers not requested are ignored.",
        "operationId": "pulls.requested_reviewers.remove",
        "parameters": [
          {
