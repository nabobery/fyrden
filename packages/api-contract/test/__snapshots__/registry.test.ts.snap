    "/repos/{owner}/{repo}/rulesets": {
      "get": {
        "description": "The repository's rulesets, by id.",
        "operationId": "repos.rulesets.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "rulesets": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "actor_types": {
                            "anyOf": [
                              {
                                "description": "Fyrden: the principal types it applies to (all when left out); \`["agent"]\` makes agents use pull requests.",
                                "items": {
                                  "enum": [
                                    "user",
                                    "org",
                                    "agent",
                                    "installation",
                                  ],
                                  "type": "string",
                                },
                                "maxItems": 4,
                                "minItems": 1,
                                "type": "array",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "bypass_actors": {
                            "default": [],
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "actor_id": {
                                  "description": "Callers with this role or a stronger one bypass the ruleset.",
                                  "enum": [
                                    "read",
                                    "triage",
                                    "write",
                                    "maintain",
                                    "admin",
                                  ],
                                  "type": "string",
                                },
                                "actor_type": {
                                  "const": "RepositoryRole",
                                  "type": "string",
                                },
                                "bypass_mode": {
                                  "const": "always",
                                  "default": "always",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "actor_type",
                                "actor_id",
                                "bypass_mode",
                              ],
                              "type": "object",
                            },
                            "maxItems": 10,
                            "type": "array",
                          },
                          "conditions": {
                            "additionalProperties": false,
                            "properties": {
                              "ref_name": {
                                "additionalProperties": false,
                                "properties": {
                                  "exclude": {
                                    "default": [],
                                    "items": {
                                      "description": "A full ref name pattern (\`refs/heads/main\`, \`refs/heads/release/*\`, \`refs/tags/**\`), \`~DEFAULT_BRANCH\` or \`~ALL\`. \`*\` stays within a path segment; \`**\` crosses them.",
                                      "maxLength": 255,
                                      "minLength": 1,
                                      "type": "string",
                                    },
                                    "maxItems": 50,
                                    "type": "array",
                                  },
                                  "include": {
                                    "items": {
                                      "description": "A full ref name pattern (\`refs/heads/main\`, \`refs/heads/release/*\`, \`refs/tags/**\`), \`~DEFAULT_BRANCH\` or \`~ALL\`. \`*\` stays within a path segment; \`**\` crosses them.",
                                      "maxLength": 255,
                                      "minLength": 1,
                                      "type": "string",
                                    },
                                    "maxItems": 50,
                                    "minItems": 1,
                                    "type": "array",
                                  },
                                },
                                "required": [
                                  "include",
                                  "exclude",
                                ],
                                "type": "object",
                              },
                            },
                            "required": [
                              "ref_name",
                            ],
                            "type": "object",
                          },
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "enforcement": {
                            "description": "\`active\` blocks, \`evaluate\` only reports what it would block, \`disabled\` does nothing.",
                            "enum": [
                              "active",
                              "evaluate",
                              "disabled",
                            ],
                            "type": "string",
                          },
                          "id": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "name": {
                            "description": "Unique in the repository.",
                            "maxLength": 100,
                            "minLength": 1,
                            "type": "string",
                          },
                          "rules": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "parameters": {
                                  "additionalProperties": false,
                                  "description": "For \`pull_request\` only: what a merge needs; left out, nothing beyond the pull request.",
                                  "properties": {
                                    "allow_agent_approvals": {
                                      "default": false,
                                      "description": "Fyrden: reviews submitted by agents count toward approvals (a person's own agents count as that person). By default only people's reviews count.",
                                      "type": "boolean",
                                    },
                                    "allowed_merge_methods": {
                                      "default": [
                                        "merge",
                                        "squash",
                                        "rebase",
                                      ],
                                      "items": {
                                        "enum": [
                                          "merge",
                                          "squash",
                                          "rebase",
                                        ],
                                        "type": "string",
                                      },
                                      "maxItems": 3,
                                      "minItems": 1,
                                      "type": "array",
                                    },
                                    "dismiss_stale_reviews_on_push": {
                                      "default": false,
                                      "description": "A push makes earlier reviews stop counting.",
                                      "type": "boolean",
                                    },
                                    "require_code_owner_review": {
                                      "const": false,
                                      "default": false,
                                      "description": "Code owners are not supported yet: must be false.",
                                      "type": "boolean",
                                    },
                                    "require_last_push_approval": {
                                      "default": false,
                                      "description": "Someone other than the last pusher must approve the current head after the last push (an approval of an earlier head does not count).",
                                      "type": "boolean",
                                    },
                                    "required_approving_review_count": {
                                      "default": 0,
                                      "description": "Approving reviews a merge needs, from people with write access other than the author.",
                                      "maximum": 10,
                                      "minimum": 0,
                                      "type": "integer",
                                    },
                                    "required_review_thread_resolution": {
                                      "default": false,
                                      "description": "Every review thread must be resolved.",
                                      "type": "boolean",
                                    },
                                    "required_reviewers": {
                                      "description": "Reviews required from specific teams are not supported yet: empty or left out.",
                                      "items": {
                                        "not": {},
                                      },
                                      "maxItems": 0,
                                      "type": "array",
                                    },
                                  },
                                  "required": [
                                    "required_approving_review_count",
                                    "dismiss_stale_reviews_on_push",
                                    "require_last_push_approval",
                                    "required_review_thread_resolution",
                                    "require_code_owner_review",
                                    "allowed_merge_methods",
                                    "allow_agent_approvals",
                                  ],
                                  "type": "object",
                                },
                                "type": {
                                  "description": "\`creation\`, \`update\`, \`deletion\` (of a matching ref), \`non_fast_forward\` (no force pushes), \`required_signatures\` (every new commit verified), \`pull_request\` (no direct pushes; changes come through pull requests, merged as its \`parameters\` require), Fyrden's \`require_up_to_date\` (a pull request merged into the branch must already contain the branch's latest commit).",
                                  "enum": [
                                    "creation",
                                    "update",
                                    "deletion",
                                    "non_fast_forward",
                                    "required_signatures",
                                    "pull_request",
                                    "require_up_to_date",
                                  ],
                                  "type": "string",
                                },
                              },
                              "required": [
                                "type",
                              ],
                              "type": "object",
                            },
                            "maxItems": 7,
                            "minItems": 1,
                            "type": "array",
                          },
                          "target": {
                            "default": "branch",
                            "enum": [
                              "branch",
                              "tag",
                            ],
                            "type": "string",
                          },
                          "updated_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "id",
                          "name",
                          "target",
                          "enforcement",
                          "conditions",
                          "rules",
                          "bypass_actors",
                          "created_at",
                          "updated_at",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "rulesets",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List rulesets",
        "x-fyrden-permission": "metadata:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Adds rules on the branches or tags whose names match: pushes, file writes and every other change of a matching ref are checked against them (refused ones are \`ng\`, naming the ruleset). Rules on names and kinds of change are checked before a push is stored; force pushes and signatures at its commit, with the rulesets current then. At most 50 per repository. Administrators only.",
        "operationId": "repos.rulesets.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "actor_types": {
                    "description": "Fyrden: the principal types it applies to (all when left out); \`["agent"]\` makes agents use pull requests.",
                    "items": {
                      "enum": [
                        "user",
                        "org",
                        "agent",
                        "installation",
                      ],
                      "type": "string",
                    },
                    "maxItems": 4,
                    "minItems": 1,
                    "type": "array",
                  },
                  "bypass_actors": {
                    "default": [],
                    "items": {
                      "properties": {
                        "actor_id": {
                          "description": "Callers with this role or a stronger one bypass the ruleset.",
                          "enum": [
                            "read",
                            "triage",
                            "write",
                            "maintain",
                            "admin",
