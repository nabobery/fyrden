                          "start_side": {
                            "anyOf": [
                              {
                                "enum": [
                                  "LEFT",
                                  "RIGHT",
                                ],
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "thread_id": {
                            "description": "Fyrden: the thread it is in.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "updated_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "user": {
                            "additionalProperties": false,
                            "description": "Who wrote it (the user, when agents acted for one).",
                            "properties": {
                              "id": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "id",
                            ],
                            "type": "object",
                          },
                        },
                        "required": [
                          "id",
                          "pull_request_review_id",
                          "thread_id",
                          "user",
                          "performed_via_agents",
                          "body",
                          "commit_id",
                          "original_commit_id",
                          "path",
