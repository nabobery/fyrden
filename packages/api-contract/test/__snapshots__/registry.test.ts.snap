    "/repos/{owner}/{repo}/commits": {
      "get": {
        "description": "The history from a branch, tag or commit (the default branch without \`sha\`), newest first, as \`git log\` lists it (unless commit dates go backwards: the order is by corrected commit date); with \`path\`, only commits that change that file or directory. A page can hold fewer commits than \`per_page\` and still have a next one.",
        "operationId": "repos.commits.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sha",
            "required": false,
            "schema": {
              "description": "Where the history starts: a branch, tag or commit SHA.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "description": "Only commits changing this path.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 8000,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "commits": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "commit": {
                            "additionalProperties": false,
                            "properties": {
                              "author": {
                                "additionalProperties": false,
                                "properties": {
                                  "date": {
                                    "description": "ISO 8601, UTC.",
                                    "type": "string",
                                  },
                                  "email": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "name",
                                  "email",
                                  "date",
                                ],
                                "type": "object",
                              },
                              "committer": {
                                "additionalProperties": false,
                                "properties": {
                                  "date": {
                                    "description": "ISO 8601, UTC.",
                                    "type": "string",
                                  },
                                  "email": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "name",
                                  "email",
                                  "date",
                                ],
                                "type": "object",
                              },
                              "message": {
                                "type": "string",
                              },
                              "tree": {
                                "additionalProperties": false,
                                "properties": {
                                  "sha": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "sha",
                                ],
                                "type": "object",
                              },
                              "verification": {
                                "additionalProperties": false,
                                "description": "Whether the commit is signed with a key Fyrden knows: the platform's key for commits it made (file writes, generated repositories).",
                                "properties": {
                                  "payload": {
                                    "description": "What the signature covers: the commit without it.",
                                    "type": [
                                      "string",
                                      "null",
                                    ],
                                  },
                                  "reason": {
                                    "description": "\`valid\` (signed by a known key), \`unsigned\`, \`unknown_key\`, \`invalid\`, \`malformed_signature\` or \`unknown_signature_type\`, as GitHub names them.",
                                    "type": "string",
                                  },
                                  "signature": {
                                    "description": "The armored signature.",
                                    "type": [
                                      "string",
                                      "null",
                                    ],
                                  },
                                  "verified": {
                                    "type": "boolean",
                                  },
                                  "verified_at": {
                                    "type": [
                                      "string",
                                      "null",
                                    ],
                                  },
                                },
                                "required": [
                                  "verified",
                                  "reason",
                                  "signature",
                                  "payload",
                                  "verified_at",
                                ],
                                "type": "object",
                              },
                            },
                            "required": [
                              "message",
                              "author",
                              "committer",
                              "tree",
                              "verification",
                            ],
                            "type": "object",
                          },
                          "parents": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "sha": {
                                  "description": "A full commit SHA (40 hex digits).",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "sha",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "sha": {
                            "description": "A full commit SHA (40 hex digits).",
                            "type": "string",
                          },
                        },
                        "required": [
                          "sha",
                          "commit",
                          "parents",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                  },
                  "required": [
                    "commits",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List commits",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
