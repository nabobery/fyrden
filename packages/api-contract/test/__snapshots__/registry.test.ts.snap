    "/repos/{owner}/{repo}/git/trees/{tree_sha}": {
      "get": {
        "description": "The root tree of a branch, tag or commit (\`tree_sha\` names one of them: a bare tree SHA is not accepted), with \`recursive\` every file and directory below it, as \`git ls-tree -r -t\` lists them. A listing of more than 10,000 entries, or of more trees than one request may read, is \`truncated\`.",
        "operationId": "repos.trees.get",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "tree_sha",
            "required": true,
            "schema": {
              "description": "A branch, a tag or a commit SHA.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "recursive",
            "required": false,
            "schema": {
              "description": "\`1\` or \`true\` lists every entry below the root.",
              "enum": [
                "0",
                "1",
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "sha": {
                      "description": "The root tree's SHA.",
                      "type": "string",
                    },
                    "tree": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "mode": {
                            "description": "Git's mode in octal: \`100644\`, \`100755\`, \`120000\`, \`040000\`, \`160000\`.",
                            "type": "string",
                          },
                          "path": {
                            "type": "string",
                          },
                          "sha": {
                            "description": "A full object SHA (40 hex digits).",
                            "type": "string",
                          },
                          "type": {
                            "enum": [
                              "blob",
                              "tree",
                              "commit",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "path",
                          "mode",
                          "type",
                          "sha",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "truncated": {
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "sha",
                    "tree",
                    "truncated",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get a tree",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
