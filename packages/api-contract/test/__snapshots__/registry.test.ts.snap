                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Fyrden: while closed as a duplicate, the issue or pull request it duplicates; null when there is none, or when the caller cannot read that one or it was deleted.",
                          },
                          "id": {
                            "description": "Fyrden: the number again (issues have no separate id space).",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "labels": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "color": {
                                  "type": "string",
                                },
                                "default": {
                                  "description": "Copied in from a default set.",
                                  "type": "boolean",
                                },
                                "description": {
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                                "id": {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer",
