    "/repos/{owner}/{repo}/pulls/{pull_number}/update-branch": {
      "put": {
        "description": "Merges the base branch's tip into an open pull request's head branch (a merge commit made and signed by the server; parents: the head, then the base tip). Write access; the head branch's rulesets apply. A head branch in a fork is written there: the caller needs write access to the fork, or the pull request's \`maintainer_can_modify\` (the author still writing the fork); that repository's rulesets apply. Refused (422) when it conflicts (resolve the conflicts instead) or when the head already contains the base tip; refused (409) when \`expected_head_sha\` is not the head. Done before the answer, which is GitHub's 202.",
        "operationId": "pulls.branch.update",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "expected_head_sha": {
                    "description": "The head the pull request must be at.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                    "sha": {
                      "description": "Fyrden: the merge commit the head branch now points at.",
                      "type": "string",
                    },
                    "url": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                    "url",
                    "sha",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Accepted",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Update a pull request branch",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/repos/{owner}/{repo}/readme": {
      "get": {
        "description": "The README file in the root directory at a branch, tag or commit (\`README.md\` first, then other README files).",
        "operationId": "repos.readme.get",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "ref",
            "required": false,
            "schema": {
              "description": "A branch, a tag or a full commit SHA; the default branch when absent.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "entries": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "mode": {
                                "description": "Git's mode in octal: \`100644\`, \`100755\`, \`120000\`, \`040000\`, \`160000\`.",
                                "type": "string",
                              },
                              "name": {
                                "type": "string",
                              },
                              "path": {
                                "type": "string",
                              },
                              "sha": {
                                "description": "A full object SHA (40 hex digits).",
                                "type": "string",
                              },
                              "type": {
                                "enum": [
                                  "file",
                                  "dir",
                                  "symlink",
                                  "submodule",
                                ],
                                "type": "string",
                              },
                            },
                            "required": [
                              "type",
                              "name",
                              "path",
                              "sha",
                              "mode",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "next_cursor": {
                          "description": "Pass as \`cursor\` for the next page of entries; null on the last page.",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "type": {
                          "const": "dir",
                          "type": "string",
                        },
                      },
                      "required": [
                        "type",
                        "path",
                        "sha",
                        "entries",
                        "next_cursor",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "content": {
                          "description": "The file's bytes, base64; empty when \`encoding\` is \`none\`.",
                          "type": "string",
                        },
                        "download_url": {
                          "description": "The raw bytes at the same commit (the same token works).",
                          "type": "string",
                        },
                        "encoding": {
                          "description": "\`none\` when the file is too large to include.",
                          "enum": [
                            "base64",
                            "none",
                          ],
                          "type": "string",
                        },
                        "mode": {
                          "description": "Git's mode in octal: \`100644\`, \`100755\`, \`120000\`, \`040000\`, \`160000\`.",
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "size": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "type": {
                          "const": "file",
                          "type": "string",
                        },
                      },
                      "required": [
