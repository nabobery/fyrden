      "patch": {
        "description": "Changes the title or body, retargets it onto another base branch, marks it a draft or ready, closes or reopens it, or lets the base's maintainers change a head branch in a fork; fields left out are kept, and all of it happens or none. The author may do any of it to its own pull request; on anyone else's, triage closes and reopens and write does the rest, except \`maintainer_can_modify\`, which only the author sets. Reopening needs the head branch to exist.",
        "operationId": "pulls.update",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
