    "/repos/{owner}/{repo}/forks": {
      "post": {
        "description": "Creates a fork of a repository the caller can read, owned by the caller, in the same fork network: it starts with the parent's branches, tags and default branch, and shares the parent's stored objects, so no data is copied. The fork can be cloned as soon as this returns. Answers 409 \`network_busy\` while the network's storage is being collected; retry after a few seconds.",
        "operationId": "repos.fork",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The parent's owner handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The parent repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "description": "The fork's name. Default: the parent's name.",
                    "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                    "type": "string",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "default_branch": {
                      "type": "string",
                    },
                    "description": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "full_name": {
                      "description": "owner/name",
                      "type": "string",
                    },
                    "id": {
                      "description": "Immutable repository id (rep_ prefix).",
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "owner": {
                      "description": "The owner's handle.",
                      "type": "string",
                    },
                    "visibility": {
                      "enum": [
                        "public",
                        "internal",
                        "private",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "owner",
                    "name",
                    "full_name",
                    "visibility",
                    "description",
                    "default_branch",
                    "created_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Fork a repository",
        "x-fyrden-permission": "repos:create",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
