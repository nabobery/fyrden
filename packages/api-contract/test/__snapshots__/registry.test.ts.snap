    "/repos/{owner}/{repo}/pulls/{pull_number}/reviews": {
      "get": {
        "description": "A pull request's reviews, in the order submitted.",
        "operationId": "pulls.reviews.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100. Fyrden: a page also ends once its items pass 1 MiB of JSON (always one item at least), with \`next_cursor\` to go on.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "description": "Fyrden: only items whose id is greater than this (not with \`cursor\`).",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "reviews": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "body": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "commit_id": {
                            "description": "The head commit it reviewed: it counts for that commit only.",
                            "type": "string",
                          },
                          "dismissal": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "at": {
                                    "description": "Unix time in milliseconds.",
                                    "maximum": 9007199254740991,
                                    "minimum": -9007199254740991,
                                    "type": "integer",
                                  },
                                  "by": {
                                    "type": "string",
                                  },
                                  "message": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "by",
                                  "message",
                                  "at",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Fyrden: who dismissed it, why and when; null unless \`state\` is DISMISSED.",
                          },
                          "id": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "performed_via_agents": {
                            "description": "Fyrden: the agents that submitted it for \`user\`, the acting one first; empty if none.",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "state": {
                            "enum": [
                              "APPROVED",
                              "CHANGES_REQUESTED",
                              "COMMENTED",
                              "DISMISSED",
                            ],
                            "type": "string",
                          },
                          "submitted_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "user": {
                            "additionalProperties": false,
                            "description": "Who submitted it (the user, when agents acted for one).",
                            "properties": {
                              "id": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "id",
                            ],
                            "type": "object",
                          },
                        },
                        "required": [
                          "id",
                          "user",
                          "performed_via_agents",
                          "state",
                          "body",
                          "commit_id",
                          "submitted_at",
                          "dismissal",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "reviews",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List reviews",
        "x-fyrden-permission": "pull_requests:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Approves, requests changes or comments on a pull request at \`commit_id\`, a head it has had: the review counts for that commit only. Anyone who can read the repository may review an open pull request; whether a review counts toward a merge (write access or above, not the author, people only unless the ruleset allows agents) is decided when merging. The author may only comment. Requesting changes or commenting needs a body.",
        "operationId": "pulls.reviews.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "maxLength": 65536,
                    "type": "string",
                  },
                  "commit_id": {
                    "description": "The head commit reviewed: the pull request's \`head.sha\` when you read it.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                  "event": {
                    "enum": [
                      "APPROVE",
                      "REQUEST_CHANGES",
                      "COMMENT",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "commit_id",
                  "event",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "body": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "commit_id": {
                      "description": "The head commit it reviewed: it counts for that commit only.",
                      "type": "string",
                    },
                    "dismissal": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "at": {
                              "description": "Unix time in milliseconds.",
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
                            },
                            "by": {
                              "type": "string",
                            },
                            "message": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "by",
                            "message",
                            "at",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Fyrden: who dismissed it, why and when; null unless \`state\` is DISMISSED.",
                    },
                    "id": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "performed_via_agents": {
                      "description": "Fyrden: the agents that submitted it for \`user\`, the acting one first; empty if none.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "state": {
                      "enum": [
                        "APPROVED",
                        "CHANGES_REQUESTED",
                        "COMMENTED",
                        "DISMISSED",
                      ],
                      "type": "string",
                    },
                    "submitted_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "user": {
                      "additionalProperties": false,
                      "description": "Who submitted it (the user, when agents acted for one).",
                      "properties": {
                        "id": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "id",
                    "user",
                    "performed_via_agents",
                    "state",
                    "body",
                    "commit_id",
                    "submitted_at",
                    "dismissal",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
