            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name (or a name it had before a rename).",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
