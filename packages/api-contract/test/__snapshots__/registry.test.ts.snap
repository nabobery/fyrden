                    },
                    "id": {
                      "description": "The key's id (key_ prefix).",
                      "type": "string",
                    },
                    "key": {
                      "description": "The public key line (\`ssh-ed25519 AAAA...\`), without its comment.",
                      "type": "string",
                    },
                    "title": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "title",
                    "key",
                    "fingerprint",
                    "created_at",
                  ],
                  "type": "object",
                },
