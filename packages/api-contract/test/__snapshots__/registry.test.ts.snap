    "/user/repos/delete": {
      "post": {
        "description": "Deletes up to 100 repositories you own, by name, as \`DELETE /repos/{owner}/{repo}\` does for one. Each name answers \`deleting\`, \`deleted\` or \`not_found\` (no such repository, or the token cannot administer it). Deletions this request does not finish continue in the background.",
        "operationId": "repos.delete_many",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "names": {
                    "description": "Names of repositories you own; a name given twice (ignoring case) counts once.",
                    "items": {
                      "description": "1-100 letters, digits, '.', '_' and '-'; not '.' or '..'; must not end in '.git'. Unique per owner, ignoring case.",
                      "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                      "type": "string",
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [
                  "names",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "results": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "name": {
                            "type": "string",
                          },
                          "state": {
                            "enum": [
                              "deleting",
                              "deleted",
                              "not_found",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "name",
                          "id",
                          "state",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "results",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Delete several of your repositories",
        "x-fyrden-permission": "administration:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/user/ssh_signing_keys": {
      "get": {
        "description": "The SSH keys the authenticated user (or an agent, with its own token) signs commits with, oldest first.",
        "operationId": "users.ssh_signing_keys.list",
        "parameters": [
          {
            "in": "query",
            "name": "per_page",
