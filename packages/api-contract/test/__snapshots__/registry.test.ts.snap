                    "active_lock_reason": {
                      "anyOf": [
                        {
                          "enum": [
                            "off-topic",
                            "too heated",
                            "resolved",
                            "spam",
                          ],
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "assignee": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "id",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "The first of \`assignees\` (GitHub's older field); null for none.",
                    },
                    "assignees": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "base": {
                      "additionalProperties": false,
                      "description": "The branch the changes are for.",
                      "properties": {
                        "ref": {
                          "description": "The branch, without refs/heads/.",
                          "type": "string",
                        },
                        "sha": {
                          "description": "Its commit when last recorded.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "ref",
                        "sha",
                      ],
                      "type": "object",
                    },
                    "body": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "closed_at": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Unix time in milliseconds.",
                    },
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "draft": {
                      "type": "boolean",
                    },
                    "head": {
                      "additionalProperties": false,
                      "description": "The branch with the changes. \`refs/pull/{number}/head\` points at \`head.sha\` and can be fetched.",
                      "properties": {
                        "ref": {
                          "description": "The branch, without refs/heads/.",
                          "type": "string",
                        },
                        "sha": {
                          "description": "Its commit when last recorded.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "ref",
                        "sha",
                      ],
                      "type": "object",
                    },
                    "head_ref_deleted": {
                      "description": "Fyrden: the head branch was deleted; the pull request stays at its last head commit and cannot be reopened until the branch exists again.",
                      "type": "boolean",
                    },
                    "head_repo_id": {
                      "description": "Fyrden: the repository the head branch is in (a fork in the same network); null for this one.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "labels": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "color": {
                            "type": "string",
                          },
                          "default": {
                            "description": "Copied in from a default set.",
                            "type": "boolean",
                          },
                          "description": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "id": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "name": {
                            "type": "string",
                          },
                          "version": {
                            "description": "Fyrden: the record's edit baseline, moved by every change of the record itself (not by reactions, counts or what it embeds); an update given it as \`expected_version\` applies only while it is still this (409 \`stale\` otherwise).",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "id",
                          "name",
                          "color",
                          "description",
                          "default",
                          "version",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "locked": {
                      "description": "Its conversation is locked: only write access and above comment and review.",
                      "type": "boolean",
                    },
                    "maintainer_can_modify": {
                      "description": "Whether those with write access to the base may change the head branch when it is in a fork (updating it, resolving its conflicts, applying suggestions), as long as its author can.",
                      "type": "boolean",
                    },
                    "merge_commit_sha": {
                      "description": "Once merged, the commit the base branch moved to.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "mergeable": {
                      "description": "Whether the head merges into the base branch's tip without conflicts; null while it is worked out (in the background, after each change of either) and once closed. Rulesets are not part of it: they are checked when merging.",
                      "type": [
                        "boolean",
                        "null",
                      ],
                    },
                    "mergeable_reason": {
                      "anyOf": [
                        {
                          "enum": [
                            "pending",
                            "too_expensive",
                            "unreadable",
                          ],
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Fyrden: why \`mergeable\` is null while open. \`pending\`: not worked out yet; \`too_expensive\`: past the budgets for working it out in the background (merging may still succeed); \`unreadable\`: an object it needs could not be read. The last two are worked out again after a delay (10 minutes, doubling to 6 hours), and at once when the base tip or head moves. Null once known, and once closed.",
                    },
                    "mergeable_state": {
