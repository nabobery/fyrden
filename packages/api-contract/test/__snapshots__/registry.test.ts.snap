    "/repos/{owner}/{repo}/git/trees/{tree_sha}": {
      "get": {
        "description": "The root tree of a branch, tag or commit (\`tree_sha\` names one of them: a bare tree SHA is not accepted), with \`recursive\` every file and directory below it, as \`git ls-tree -r -t\` lists them. A listing of more than 10,000 entries, or of more trees than one request may read, is \`truncated\`.",
        "operationId": "repos.trees.get",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "tree_sha",
            "required": true,
            "schema": {
              "description": "A branch, a tag or a commit SHA.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string",
            },
          },
