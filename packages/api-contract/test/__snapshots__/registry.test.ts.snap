    "/repos/{owner}/{repo}/issues/{issue_number}/assignees": {
      "delete": {
        "description": "Unassigns users or agents from an issue or pull request; ones not assigned are ignored. Answers the issue. Fyrden's \`assignee_ids\` name them by id (a deleted user's handle names no one). Takes triage, and the permission for the subject's kind (\`issues:write\`, or \`pull_requests:write\` for a pull request's number).",
        "operationId": "issues.assignees.remove",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "issue_number",
            "required": true,
            "schema": {
              "description": "The issue's or pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "assignee_ids": {
                    "description": "Fyrden: user and agent ids.",
                    "items": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array",
                  },
                  "assignees": {
                    "description": "Handles of users and agents who can read the repository.",
                    "items": {
                      "maxLength": 39,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
                      "type": "string",
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
