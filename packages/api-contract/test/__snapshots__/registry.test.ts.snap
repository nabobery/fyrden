        "description": "Takes a label off an issue or pull request (one it does not have changes nothing; one the repository does not have is not found). Answers its labels. Takes triage, and the permission for the subject's kind (\`issues:write\`, or \`pull_requests:write\` for a pull request's number).",
        "operationId": "issues.labels.remove",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "issue_number",
            "required": true,
            "schema": {
              "description": "The issue's or pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "A label's name (matched ignoring the case of ASCII letters); not \`.\` or \`..\`.",
              "maxLength": 50,
              "minLength": 1,
              "pattern": "^(?!\\.\\.?$)[^\\x00-\\x1f\\x7f-\\x9f\\s](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\x00-\\x1f\\x7f-\\x9f\\s])?$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "expected_id": {
                    "description": "Fyrden: the id of the label \`name\` named when the change was made; refused with 409 \`stale\` when the name names another now (renamed, then taken). \`expected_version\` needs it.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "labels": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "color": {
                            "type": "string",
                          },
                          "default": {
                            "description": "Copied in from a default set.",
                            "type": "boolean",
                          },
                          "description": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "id": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "name": {
                            "type": "string",
                          },
                          "version": {
                            "description": "Fyrden: the record's edit baseline, moved by every change of the record itself (not by reactions, counts or what it embeds); an update given it as \`expected_version\` applies only while it is still this (409 \`stale\` otherwise).",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "id",
                          "name",
                          "color",
                          "description",
                          "default",
                          "version",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "labels",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Remove a label from an issue",
        "x-fyrden-permission": "metadata:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/repos/{owner}/{repo}/issues/{issue_number}/lock": {
      "delete": {
        "description": "Unlocks an issue's or a pull request's conversation. Takes write access, and the permission for that kind. Answers the lock (GitHub answers 204).",
        "operationId": "issues.unlock",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
