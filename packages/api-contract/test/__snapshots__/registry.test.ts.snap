                          "type": "string",
                        },
                        "encoding": {
                          "description": "\`none\` when the file is too large to include.",
                          "enum": [
                            "base64",
                            "none",
                          ],
                          "type": "string",
                        },
                        "mode": {
                          "description": "Git's mode in octal: \`100644\`, \`100755\`, \`120000\`, \`040000\`, \`160000\`.",
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "size": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "type": {
                          "const": "file",
                          "type": "string",
                        },
                      },
                      "required": [
