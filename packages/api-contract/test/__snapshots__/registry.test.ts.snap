      "get": {
        "description": "The repository's milestones by due date, then number; one without a due date counts as due after every date (last ascending, first descending). GitHub's \`completeness\` order is not offered. Takes the \`issues:read\` or \`pull_requests:read\` permission (milestones serve both).",
        "operationId": "milestones.list",
        "parameters": [
          {
            "in": "path",
