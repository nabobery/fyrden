                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "When it is deleted (Unix time in milliseconds); null to keep it.",
                          },
                          "fork": {
                            "description": "Whether the repository was forked from another.",
                            "type": "boolean",
                          },
                          "full_name": {
                            "description": "owner/name",
                            "type": "string",
                          },
                          "id": {
                            "description": "Immutable repository id (rep_ prefix).",
                            "type": "string",
                          },
