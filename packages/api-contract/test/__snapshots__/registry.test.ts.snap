      "patch": {
        "description": "Replaces a diff comment's body. Its author may edit its own; write access and above, anyone's.",
        "operationId": "pulls.comments.update",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
