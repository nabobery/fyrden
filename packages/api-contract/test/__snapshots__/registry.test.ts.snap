                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "body": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "closed_at": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Unix time in milliseconds.",
                          },
                          "closed_by": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "id",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Who closed it last, while closed; null for pull requests.",
                          },
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "duplicate_of": {
                            "anyOf": [
