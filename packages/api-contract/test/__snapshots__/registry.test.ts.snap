          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "maxLength": 65536,
                    "type": "string",
                  },
                  "commit_id": {
                    "description": "The head the lines are of; needed unless replying.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                  "in_reply_to": {
                    "description": "A comment to reply to.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "line": {
                    "description": "The (last) line; needed unless replying.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "path": {
                    "description": "The file; needed unless replying.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string",
                  },
                  "side": {
                    "default": "RIGHT",
                    "enum": [
                      "LEFT",
                      "RIGHT",
                    ],
                    "type": "string",
                  },
                  "start_line": {
                    "description": "The first line, for a range.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "start_side": {
                    "description": "As \`side\`; a range stays on one side.",
                    "enum": [
                      "LEFT",
                      "RIGHT",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "body",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
