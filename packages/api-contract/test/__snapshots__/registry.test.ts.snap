    "/repos/{owner}/{repo}/file-commits": {
      "post": {
        "description": "Writes and deletes up to 100 files (4 MiB of content together) as one commit on a branch. With \`expected_head\`, fails with 409 unless the branch is still at that commit; the commit is always made on the head it was built on, so a branch that moves meanwhile also fails with 409.",
        "operationId": "repos.file_commits.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "author": {
                    "description": "The commit's author; the authenticated principal when absent (always the committer).",
                    "properties": {
                      "email": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                      "name": {
                        "maxLength": 256,
                        "minLength": 1,
