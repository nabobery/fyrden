                                  "heart",
                                  "hooray",
                                  "rocket",
                                  "eyes",
                                ],
                                "type": "string",
                              },
                              "id": {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                            },
                            "required": [
                              "id",
                              "content",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                      },
                      "required": [
                        "total_count",
                        "+1",
                        "-1",
                        "laugh",
                        "confused",
                        "heart",
                        "hooray",
                        "rocket",
                        "eyes",
                      ],
                      "type": "object",
                    },
                    "resolved": {
                      "description": "Fyrden: its thread is resolved.",
                      "type": "boolean",
                    },
                    "side": {
                      "description": "\`RIGHT\`: the head's file; \`LEFT\`: the merge base's.",
                      "enum": [
                        "LEFT",
