      "post": {
        "description": "Proposes merging one branch of the repository into another. Anyone who can read the repository may open one. Refused when the head has no commits the base lacks, or when a pull request between the two branches is already open. While open, \`refs/pull/{number}/head\` follows the head branch. The head may be a branch of a fork in the same network (\`owner:branch\`): its revision is imported first, and later pushes to it reach the pull request shortly after.",
        "operationId": "pulls.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
