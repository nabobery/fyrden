                        "path",
                        "name",
                        "sha",
                        "mode",
                        "size",
                        "encoding",
                        "content",
                        "download_url",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "content": {
                          "description": "The target's exact bytes, base64.",
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "size": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "target": {
