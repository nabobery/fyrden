                          "type": "string",
                        },
                        "path": {
                          "type": "string",
                        },
                        "sha": {
                          "description": "A full object SHA (40 hex digits).",
                          "type": "string",
                        },
                        "size": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "target": {
                          "description": "The target as UTF-8 (other bytes are replaced; see \`content\`).",
                          "type": "string",
                        },
                        "type": {
