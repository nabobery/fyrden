                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "expected_version": {
                    "description": "Fyrden: the \`version\` the change was made from; refused with 409 \`stale\` when it changed since.",
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "labels": {
                    "description": "Label names (ignoring case), each one the repository has; replaces its labels.",
                    "items": {
                      "maxLength": 50,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 100,
                    "type": "array",
