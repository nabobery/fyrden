            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
