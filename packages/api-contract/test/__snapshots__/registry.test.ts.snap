    "/repos/{owner}/{repo}/file-commits": {
      "post": {
        "description": "Writes and deletes up to 100 files (4 MiB of content together) as one commit on a branch. With \`expected_head\`, fails with 409 unless the branch is still at that commit; the commit is always made on the head it was built on, so a branch that moves meanwhile also fails with 409.",
        "operationId": "repos.file_commits.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "author": {
                    "description": "The commit's author; when absent, the agent acting for you, or you. The committer is always the platform, which signs the commit; an agent acting for a user adds a Co-authored-by trailer naming the user.",
                    "properties": {
                      "email": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                      "name": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "name",
                      "email",
                    ],
                    "type": "object",
                  },
                  "branch": {
                    "description": "The branch to commit to; the default branch when absent.",
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string",
                  },
                  "changes": {
                    "items": {
                      "description": "One file to write or delete.",
                      "properties": {
                        "content": {
                          "description": "The new content; absent with \`delete\`.",
                          "maxLength": 5800000,
                          "type": "string",
                        },
                        "delete": {
                          "description": "Delete the file instead.",
                          "type": "boolean",
                        },
                        "encoding": {
                          "default": "utf-8",
                          "description": "How \`content\` is written: plain text (\`utf-8\`) or \`base64\`.",
                          "enum": [
                            "utf-8",
                            "base64",
                          ],
                          "type": "string",
                        },
                        "mode": {
                          "description": "Default: keep an existing file's mode, else \`file\`.",
                          "enum": [
                            "file",
                            "executable",
                          ],
                          "type": "string",
                        },
                        "path": {
                          "description": "A path from the repository's root, \`a/b/c.txt\`.",
                          "maxLength": 4096,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "path",
                      ],
                      "type": "object",
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array",
                  },
                  "expected_head": {
                    "description": "The commit the branch must be at.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string",
                  },
                  "message": {
                    "description": "The commit message.",
                    "maxLength": 65536,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "message",
                  "changes",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "branch": {
                      "type": "string",
                    },
                    "commit": {
                      "additionalProperties": false,
                      "properties": {
                        "commit": {
                          "additionalProperties": false,
                          "properties": {
                            "author": {
                              "additionalProperties": false,
                              "properties": {
                                "date": {
                                  "description": "ISO 8601, UTC.",
                                  "type": "string",
                                },
                                "email": {
                                  "type": "string",
                                },
                                "name": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "name",
                                "email",
                                "date",
                              ],
                              "type": "object",
                            },
                            "committer": {
                              "additionalProperties": false,
                              "properties": {
                                "date": {
                                  "description": "ISO 8601, UTC.",
                                  "type": "string",
                                },
                                "email": {
                                  "type": "string",
                                },
                                "name": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "name",
                                "email",
                                "date",
                              ],
                              "type": "object",
                            },
                            "message": {
                              "type": "string",
                            },
                            "tree": {
                              "additionalProperties": false,
                              "properties": {
                                "sha": {
                                  "type": "string",
                                },
                              },
                              "required": [
                                "sha",
                              ],
                              "type": "object",
                            },
                            "verification": {
                              "additionalProperties": false,
                              "description": "Whether the commit is signed with a key Fyrden knows: the platform's key for commits it made (file writes, generated repositories), or a key a user added for commits whose committer is that user's no-reply address.",
                              "properties": {
                                "payload": {
                                  "description": "What the signature covers: the commit without it.",
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                                "reason": {
                                  "description": "\`valid\` (signed by a known key), \`unsigned\`, \`unknown_key\`, \`bad_email\` (a user's key, on a commit whose committer is not that user), \`invalid\`, \`malformed_signature\` or \`unknown_signature_type\`, as GitHub names them.",
                                  "type": "string",
                                },
                                "signature": {
                                  "description": "The armored signature.",
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                                "verified": {
                                  "type": "boolean",
                                },
                                "verified_at": {
                                  "type": [
                                    "string",
                                    "null",
                                  ],
                                },
                              },
                              "required": [
                                "verified",
                                "reason",
                                "signature",
                                "payload",
                                "verified_at",
                              ],
                              "type": "object",
                            },
                          },
                          "required": [
                            "message",
                            "author",
                            "committer",
                            "tree",
                            "verification",
                          ],
                          "type": "object",
                        },
                        "parents": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "sha": {
                                "description": "A full commit SHA (40 hex digits).",
                                "type": "string",
                              },
                            },
                            "required": [
                              "sha",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "sha": {
                          "description": "A full commit SHA (40 hex digits).",
                          "type": "string",
                        },
                      },
                      "required": [
                        "sha",
                        "commit",
                        "parents",
                      ],
                      "type": "object",
                    },
                    "files": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                          },
                          "sha": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                        },
                        "required": [
                          "path",
                          "sha",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "branch",
                    "commit",
                    "files",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
