                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "A milestone's number; null takes it out of its milestone.",
                  },
                  "state": {
                    "enum": [
                      "open",
                      "closed",
