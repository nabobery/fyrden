      "get": {
        "description": "Who a review of the pull request is requested of and has not reviewed yet: users and agents, and teams (a team's request ends when one of the members it asked reviews).",
        "operationId": "pulls.requested_reviewers.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "teams": {
                      "items": {
                        "additionalProperties": false,
                        "description": "A team as it was when asked (Fyrden shows these fields only).",
                        "properties": {
                          "id": {
                            "description": "The team's id (it keeps it when renamed).",
                            "type": "string",
                          },
                          "name": {
                            "type": "string",
                          },
                          "slug": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "slug",
                          "name",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "users": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                          },
                          "login": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "login",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "users",
                    "teams",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List requested reviewers",
        "x-fyrden-permission": "pull_requests:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Requests a review of users or agents who can read the repository (not the author), and of teams of the repository's organization. A team asks each member it has now (the author aside), at most 2000, and keeps those members: one of them reviewing ends its request; someone who joins the team later does not. The author may request reviews; on someone else's pull request it needs triage access. At most 15 at once, a team counting as one, and 10000 members across a pull request's teams; a request ends when its reviewer submits a review. Past the limit, requests of users or agents being deleted give up their places first, with no event.",
        "operationId": "pulls.requested_reviewers.add",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reviewers": {
                    "description": "Handles of users and agents who can read the repository.",
                    "items": {
                      "maxLength": 39,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
                      "type": "string",
                    },
                    "maxItems": 15,
                    "type": "array",
                  },
                  "team_reviewers": {
                    "description": "Slugs of teams of the repository's organization.",
                    "items": {
                      "description": "The team's slug (lowercase letters, digits and inner hyphens).",
                      "maxLength": 100,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "type": "string",
                    },
                    "maxItems": 15,
                    "type": "array",
                  },
                },
                "required": [],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
