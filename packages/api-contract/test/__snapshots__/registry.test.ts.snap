                      "type": "integer",
                    },
                    "id": {
                      "type": "string",
                    },
                    "part_count": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "part_size": {
                      "description": "Every part but the last is exactly this long; the last holds the rest.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "parts_received": {
                      "description": "Part numbers stored so far.",
                      "items": {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer",
                      },
                      "type": "array",
                    },
                    "parts_url": {
                      "description": "Upload part n with PUT <parts_url>/<n> (path on this host; git credentials).",
                      "type": "string",
                    },
                    "refs": {
                      "description": "Per-ref outcome, once the upload is complete.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "reason": {
                            "type": "string",
                          },
                          "ref": {
                            "type": "string",
                          },
                          "status": {
                            "enum": [
                              "ok",
                              "rejected",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "ref",
                          "status",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "size": {
                      "description": "The pack's length in bytes.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "state": {
                      "description": "receiving: parts may be uploaded; indexing: completing (call complete again); committed or rejected: done.",
                      "enum": [
                        "receiving",
                        "indexing",
                        "committed",
                        "rejected",
                        "expired",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "state",
                    "size",
                    "part_size",
                    "part_count",
                    "parts_received",
                    "parts_url",
                    "expires_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get a chunked pack upload",
        "x-fyrden-permission": "contents:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/repos/{owner}/{repo}/uploads/{upload_id}/complete": {
      "post": {
        "description": "Assembles the parts, indexes and checks the pack as a push is checked, and applies the ref updates in one transaction. Answers state \`indexing\` while a large pack is still being indexed: call it again. Must be called with the token that started the session.",
        "operationId": "uploads.complete",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "pattern": "^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "upload_id",
            "required": true,
            "schema": {
              "description": "The upload session id.",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string",
                    },
                    "expires_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "id": {
                      "type": "string",
                    },
                    "part_count": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "part_size": {
                      "description": "Every part but the last is exactly this long; the last holds the rest.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "parts_received": {
                      "description": "Part numbers stored so far.",
                      "items": {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer",
                      },
                      "type": "array",
                    },
                    "parts_url": {
                      "description": "Upload part n with PUT <parts_url>/<n> (path on this host; git credentials).",
                      "type": "string",
                    },
                    "refs": {
                      "description": "Per-ref outcome, once the upload is complete.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "reason": {
                            "type": "string",
                          },
                          "ref": {
                            "type": "string",
                          },
                          "status": {
                            "enum": [
                              "ok",
                              "rejected",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "ref",
                          "status",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "size": {
                      "description": "The pack's length in bytes.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "state": {
                      "description": "receiving: parts may be uploaded; indexing: completing (call complete again); committed or rejected: done.",
                      "enum": [
                        "receiving",
                        "indexing",
                        "committed",
                        "rejected",
                        "expired",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "state",
                    "size",
                    "part_size",
                    "part_count",
                    "parts_received",
                    "parts_url",
                    "expires_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Complete a chunked pack upload",
        "x-fyrden-permission": "contents:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/user": {
      "get": {
        "description": "Returns the principal and token that authenticated this request.",
        "operationId": "meta.whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "handle": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "id": {
                      "description": "Principal id (usr_, org_, agt_ or ins_ prefix).",
                      "type": "string",
                    },
                    "is_instance_admin": {
                      "type": "boolean",
                    },
                    "token": {
                      "additionalProperties": false,
                      "properties": {
                        "expires_at": {
                          "description": "Unix time in milliseconds.",
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "id": {
                          "type": "string",
                        },
                        "scopes": {
                          "items": {
                            "type": "string",
                          },
                          "type": "array",
                        },
                        "type": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "type",
                        "scopes",
                        "expires_at",
                      ],
                      "type": "object",
                    },
                    "type": {
                      "enum": [
                        "user",
                        "org",
                        "agent",
                        "installation",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "type",
                    "handle",
                    "is_instance_admin",
                    "token",
                  ],
