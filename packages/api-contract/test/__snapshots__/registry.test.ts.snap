                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string",
                  },
                  "head_repo": {
                    "description": "With \`owner:branch\`, the repository's name, when the owner has several in the network.",
                    "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                    "type": "string",
                  },
                  "maintainer_can_modify": {
                    "default": false,
