                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "user": {
                      "additionalProperties": false,
                      "description": "Who wrote it (the user, when agents acted for one).",
                      "properties": {
                        "id": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
