    "/repos/{owner}/{repo}/pulls/{pull_number}/comments": {
      "get": {
        "description": "The comments on a pull request's diff, oldest first.",
        "operationId": "pulls.comments.list",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "comments": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "body": {
                            "type": "string",
                          },
                          "commit_id": {
                            "description": "The head the thread was started on.",
                            "type": "string",
                          },
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "id": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "in_reply_to_id": {
                            "description": "The comment this one answers.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "line": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The line commented on; null once \`outdated\`.",
                          },
                          "original_commit_id": {
                            "type": "string",
                          },
                          "original_line": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "outdated": {
                            "description": "Fyrden: the diff moved on since: the head moved, or for \`LEFT\` the merge base (the base branch can move it with the head unchanged); the lines are those of \`commit_id\` (for \`LEFT\`, of the merge base then).",
                            "type": "boolean",
                          },
                          "path": {
                            "type": "string",
                          },
                          "performed_via_agents": {
                            "description": "Fyrden: the agents that wrote it for \`user\`, the acting one first; empty if none.",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "pull_request_review_id": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Always null: comments are not part of a review yet.",
                          },
                          "resolved": {
                            "description": "Fyrden: its thread is resolved.",
                            "type": "boolean",
                          },
                          "side": {
                            "description": "\`RIGHT\`: the head's file; \`LEFT\`: the merge base's.",
                            "enum": [
                              "LEFT",
                              "RIGHT",
                            ],
                            "type": "string",
                          },
                          "start_line": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The first line, for a range.",
                          },
                          "start_side": {
                            "anyOf": [
                              {
                                "enum": [
                                  "LEFT",
                                  "RIGHT",
                                ],
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "thread_id": {
                            "description": "Fyrden: the thread it is in.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "updated_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "user": {
                            "additionalProperties": false,
                            "description": "Who wrote it (the user, when agents acted for one).",
                            "properties": {
                              "id": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "id",
                            ],
                            "type": "object",
                          },
                        },
                        "required": [
                          "id",
                          "pull_request_review_id",
                          "thread_id",
                          "user",
                          "performed_via_agents",
                          "body",
                          "commit_id",
                          "original_commit_id",
                          "path",
                          "side",
                          "line",
                          "original_line",
                          "start_line",
                          "start_side",
                          "outdated",
                          "resolved",
                          "created_at",
                          "updated_at",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
