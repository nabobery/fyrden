      "post": {
        "description": "Adds an Ed25519 SSH public key the authenticated user signs commits with (\`gpg.format = ssh\`). A commit with a valid signature by it is verified when its committer email is the user's no-reply address (\`<user id>@users.noreply.<host>\`). An agent adds its own with its own token (its commits then use \`<agent id>@users.noreply.<host>\`); acting for a user under a grant it adds none. A key belongs to one principal: one already added answers 422 \`key_in_use\`.",
        "operationId": "users.ssh_signing_keys.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
