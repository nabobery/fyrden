      },
      "post": {
        "description": "Requests a review of users or agents who can read the repository (not the author). The author may request reviews; on someone else's pull request it needs triage access. At most 15 at once; a request ends when that reviewer submits a review.",
        "operationId": "pulls.requested_reviewers.add",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "repo",
            "required": true,
            "schema": {
              "description": "The repository's name.",
              "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "pull_number",
            "required": true,
            "schema": {
              "description": "The pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reviewers": {
                    "description": "Handles of users and agents who can read the repository.",
                    "items": {
                      "maxLength": 39,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
                      "type": "string",
                    },
                    "maxItems": 15,
                    "minItems": 1,
                    "type": "array",
                  },
                  "team_reviewers": {
                    "description": "Team reviewers are not supported yet: empty or left out.",
                    "items": {
                      "not": {},
                    },
                    "maxItems": 0,
                    "type": "array",
                  },
                },
                "required": [
                  "reviewers",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "base": {
                      "additionalProperties": false,
                      "description": "The branch the changes are for.",
                      "properties": {
                        "ref": {
                          "description": "The branch, without refs/heads/.",
                          "type": "string",
                        },
                        "sha": {
                          "description": "Its commit when last recorded.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "ref",
                        "sha",
                      ],
                      "type": "object",
                    },
                    "body": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "closed_at": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Unix time in milliseconds.",
                    },
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "draft": {
                      "type": "boolean",
                    },
                    "head": {
                      "additionalProperties": false,
                      "description": "The branch with the changes. \`refs/pull/{number}/head\` points at \`head.sha\` and can be fetched.",
                      "properties": {
                        "ref": {
                          "description": "The branch, without refs/heads/.",
                          "type": "string",
                        },
                        "sha": {
                          "description": "Its commit when last recorded.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "ref",
                        "sha",
                      ],
                      "type": "object",
                    },
                    "head_ref_deleted": {
                      "description": "Fyrden: the head branch was deleted; the pull request stays at its last head commit and cannot be reopened until the branch exists again.",
                      "type": "boolean",
                    },
                    "head_repo_id": {
                      "description": "Fyrden: the repository the head branch is in (a fork in the same network); null for this one.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "maintainer_can_modify": {
                      "description": "Whether those with write access to the base may change the head branch when it is in a fork (updating it, resolving its conflicts, applying suggestions), as long as its author can.",
                      "type": "boolean",
                    },
                    "merge_commit_sha": {
                      "description": "Once merged, the commit the base branch moved to.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "mergeable": {
                      "description": "Whether the head merges into the base branch's tip without conflicts; null while it is worked out (in the background, after each change of either) and once closed. Rulesets are not part of it: they are checked when merging.",
                      "type": [
                        "boolean",
                        "null",
                      ],
                    },
                    "mergeable_state": {
                      "description": "\`clean\`: no conflicts (rulesets are checked when merging); \`dirty\`: conflicts; \`draft\`; \`unknown\`: not worked out yet, or too large to work out here.",
                      "enum": [
                        "clean",
                        "dirty",
                        "draft",
                        "unknown",
                      ],
                      "type": "string",
                    },
                    "merged": {
                      "type": "boolean",
                    },
                    "merged_at": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Unix time in milliseconds.",
                    },
                    "merged_by": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "id",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Who merged it (the user, when agents acted for one).",
                    },
                    "number": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "performed_via_agents": {
                      "description": "Fyrden: the agents that opened it for \`user\`, the acting one first; empty if none.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "state": {
                      "enum": [
                        "open",
                        "closed",
                      ],
                      "type": "string",
                    },
                    "title": {
                      "type": "string",
                    },
                    "updated_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "user": {
                      "additionalProperties": false,
                      "description": "Who opened it (the user, when agents acted for one).",
                      "properties": {
                        "id": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "number",
                    "state",
                    "merged",
                    "head_repo_id",
                    "mergeable",
                    "mergeable_state",
                    "draft",
                    "maintainer_can_modify",
                    "title",
                    "body",
                    "user",
                    "performed_via_agents",
                    "head",
                    "base",
                    "head_ref_deleted",
                    "created_at",
                    "updated_at",
                    "closed_at",
                    "merged_at",
                    "merge_commit_sha",
                    "merged_by",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Request reviewers",
        "x-fyrden-permission": "pull_requests:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
