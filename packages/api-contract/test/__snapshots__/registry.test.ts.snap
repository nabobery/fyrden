                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get the authenticated principal",
        "x-fyrden-permission": "authenticated",
        "x-fyrden-principals": [
          "user",
          "org",
          "agent",
          "installation",
        ],
      },
    },
    "/user/repos": {
      "get": {
        "description": "Lists the repositories the authenticated principal owns and its token can see, by name (ignoring case). A repository created a moment ago is listed; its \`default_branch\` can lag behind a change by a few seconds (use \`GET /repos/{owner}/{repo}\` for the current one).",
        "operationId": "repos.list",
        "parameters": [
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "repos": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "default_branch": {
                            "type": "string",
                          },
                          "description": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "full_name": {
                            "description": "owner/name",
                            "type": "string",
                          },
                          "id": {
                            "description": "Immutable repository id (rep_ prefix).",
                            "type": "string",
                          },
                          "name": {
                            "type": "string",
                          },
                          "owner": {
                            "description": "The owner's handle.",
                            "type": "string",
                          },
                          "visibility": {
                            "enum": [
                              "public",
                              "internal",
                              "private",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "owner",
                          "name",
                          "full_name",
                          "visibility",
                          "description",
                          "default_branch",
                          "created_at",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "repos",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List your repositories",
        "x-fyrden-permission": "metadata:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Creates an empty private repository owned by the authenticated user. Clone and push it at \`/<owner>/<name>.git\`.",
        "operationId": "repos.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "description": "1-100 letters, digits, '.', '_' and '-'; not '.' or '..'; must not end in '.git'. Unique per owner, ignoring case.",
                    "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "default_branch": {
                      "type": "string",
                    },
                    "description": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "full_name": {
                      "description": "owner/name",
                      "type": "string",
                    },
                    "id": {
                      "description": "Immutable repository id (rep_ prefix).",
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "owner": {
                      "description": "The owner's handle.",
                      "type": "string",
                    },
                    "visibility": {
                      "enum": [
                        "public",
                        "internal",
                        "private",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "owner",
                    "name",
                    "full_name",
                    "visibility",
                    "description",
                    "default_branch",
                    "created_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Create a repository",
        "x-fyrden-permission": "repos:create",
        "x-fyrden-principals": [
          "user",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/user/repos/delete": {
      "post": {
        "description": "Deletes up to 100 repositories you own, by name, as \`DELETE /repos/{owner}/{repo}\` does for one. Each name answers \`deleting\`, \`deleted\` or \`not_found\` (no such repository, or the token cannot administer it). Deletions this request does not finish continue in the background.",
        "operationId": "repos.delete_many",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "names": {
                    "description": "Names of repositories you own; a name given twice (ignoring case) counts once.",
                    "items": {
                      "description": "1-100 letters, digits, '.', '_' and '-'; not '.' or '..'; must not end in '.git'. Unique per owner, ignoring case.",
                      "pattern": "^(?!\\.{1,2}$)(?!.*\\.[Gg][Ii][Tt]$)[A-Za-z0-9._-]{1,100}$",
                      "type": "string",
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [
                  "names",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "results": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "name": {
                            "type": "string",
                          },
                          "state": {
                            "enum": [
                              "deleting",
                              "deleted",
                              "not_found",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "name",
                          "id",
                          "state",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "results",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Delete several of your repositories",
        "x-fyrden-permission": "administration:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
  },
}
`;
