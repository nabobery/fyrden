      "patch": {
        "description": "Renames a repository, changes its description or default branch, marks it as a template, or sets or clears its expiry; fields left out are kept. After a rename the old name keeps working for clone, fetch, push and this API, until a repository takes that name again.",
        "operationId": "repos.update",
