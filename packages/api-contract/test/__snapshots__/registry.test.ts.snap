    "/feed": {
      "get": {
        "description": "The caller's activity feed: pull requests that need it or that it takes part in, one item per repository, thread and kind, in the order they last changed. Pass a previous answer's \`next_cursor\` as \`since\` for what changed after it; a changed item comes again, so keep the latest copy by \`item_key\`. An agent's own token reads the agent's feed; a delegated token reads the user's, limited to the grant's repositories. Items of repositories the caller cannot read now are left out, so a page can be short, and cursors name only items the caller was shown. An answer checks at most 100 repositories and reads at most 1,000 items, so a page can end early, even empty; the items of repositories the feed's owner itself cannot read now are then forgotten, so a later answer gets past them. Poll by \`poll_after_ms\`: while nothing changes the wait grows to 30 minutes, and an answer that shows something brings it back to 30 seconds. A cursor older than the retention (7 days, 5,000 items) or of another epoch is refused with 410 \`cursor_expired\`: start over from \`GET /feed/sync\`. The answer carries an ETag; with \`If-None-Match\` an unchanged one is 304.",
        "operationId": "feed.list",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "description": "A previous answer's \`next_cursor\`; from the start without.",
              "maxLength": 200,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "description": "Only items of this priority.",
              "enum": [
                "P0",
                "P1",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "description": "Only items of this kind.",
              "enum": [
                "review_requested",
                "changes_requested",
                "approved",
                "merge_conflict",
                "assigned",
                "mention",
                "activity",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "head_cursor": {
                      "description": "The latest change the answer found that the caller may see; the same as \`next_cursor\` unless more pages follow.",
                      "maxLength": 200,
                      "type": "string",
                    },
                    "items": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "acked_epoch": {
                            "description": "The epoch of the version last acknowledged; 0 for none.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "acked_version": {
                            "description": "The version last acknowledged; 0 for none.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "action": {
                            "description": "What happened last: \`comment\`, \`review_requested\`, \`merged\`, ...",
                            "type": "string",
                          },
                          "actor": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "actor_trust": {
                            "description": "The actor's access to the repository when it acted.",
                            "enum": [
                              "write",
                              "read",
                              "none",
                            ],
                            "type": "string",
                          },
                          "epoch": {
                            "description": "The repository's restore generation \`version\` counts in: a newer generation's versions are newer, whatever their numbers.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "event_at": {
                            "description": "When the last change happened, Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "excerpt": {
                            "description": "What the member the item displays says now (plain text, at most 280 characters), read from the repository; null when there is none or it is gone.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "item_key": {
                            "description": "The item's key: \`<repository id>:<thread>:<kind>\`.",
                            "type": "string",
                          },
                          "kind": {
                            "enum": [
                              "review_requested",
                              "changes_requested",
                              "approved",
                              "merge_conflict",
                              "assigned",
                              "mention",
                              "activity",
                            ],
                            "type": "string",
                          },
                          "members": {
                            "description": "For \`activity\`: the ids it gathers (comments, reviews), the greatest 100.",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "members_truncated": {
                            "description": "Some members were left out.",
                            "type": "boolean",
                          },
                          "priority": {
                            "description": "P0: act on this; P1: a thread you take part in.",
                            "enum": [
                              "P0",
                              "P1",
                            ],
                            "type": "string",
                          },
                          "reasons": {
                            "description": "Why it is in the feed: author, reviewer, mentioned, ...",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "repo": {
                            "additionalProperties": false,
                            "properties": {
                              "full_name": {
                                "description": "owner/name",
                                "type": "string",
                              },
                              "id": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "id",
                              "full_name",
                            ],
                            "type": "object",
                          },
                          "silent": {
                            "description": "The last change was the owner's own action (or its agents'): no notification.",
                            "type": "boolean",
                          },
                          "state": {
                            "description": "\`resolved\`: nothing to act on any more.",
                            "enum": [
                              "open",
                              "resolved",
                            ],
                            "type": "string",
                          },
                          "subject": {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "issue",
                                  "pull",
                                ],
                                "type": "string",
                              },
                              "number": {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              "title": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "number",
                              "title",
                            ],
                            "type": "object",
                          },
                          "thread_key": {
                            "description": "The thread within the repository, e.g. \`pull/12\` or \`issue/7\`.",
                            "type": "string",
                          },
                          "version": {
                            "description": "The thread's feed version the item is at; acknowledge with it and \`epoch\`.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "item_key",
                          "repo",
                          "thread_key",
                          "kind",
                          "subject",
                          "epoch",
                          "version",
                          "state",
                          "priority",
                          "reasons",
                          "silent",
                          "action",
                          "actor",
                          "actor_trust",
                          "excerpt",
                          "members",
                          "members_truncated",
                          "event_at",
                          "acked_epoch",
                          "acked_version",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "next_cursor": {
                      "description": "Pass as \`since\` next: after the last item shown (where the answer started when none was).",
                      "maxLength": 200,
                      "type": "string",
                    },
                    "poll_after_ms": {
                      "description": "Wait at least this long (milliseconds) before polling \`GET /feed\` again with \`next_cursor\` (a sync's \`head_cursor\`): 0 after a full page, as more may follow; else 30 seconds after an answer that showed something, or a sync, doubling with each answer in a row that showed nothing (the cursor counts them), up to 30 minutes.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "head_cursor",
                    "poll_after_ms",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                },
              },
            },
          },
          "304": {
            "description": "Not Modified: the If-None-Match ETag matches",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Get the activity feed",
        "x-fyrden-permission": "authenticated",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/feed/ack": {
      "post": {
        "description": "Records that the feed's owner has seen an item at a version, its \`epoch\` and \`version\` (every reader of the feed shares it, and the item comes again in \`GET /feed\`). Versions order by epoch, then version. A version the item does not have yet is refused (409); an older one than already acknowledged changes nothing.",
        "operationId": "feed.ack",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "epoch": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "item_key": {
                    "maxLength": 300,
                    "type": "string",
                  },
                  "version": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                },
                "required": [
                  "item_key",
                  "epoch",
                  "version",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "acked_epoch": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "acked_version": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "epoch": {
                      "description": "The item's current epoch.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "item_key": {
                      "type": "string",
                    },
                    "version": {
                      "description": "The item's current version.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "item_key",
                    "epoch",
                    "version",
                    "acked_epoch",
                    "acked_version",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Acknowledge a feed item",
        "x-fyrden-permission": "authenticated",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/feed/sync": {
      "get": {
        "description": "The feed's current state, to start from or start over: open P0 items, then P1 items of the last 7 days, newest first (500 at most), and the cursor to follow with \`GET /feed\`. Items of repositories the caller cannot read now are left out. \`complete\` is false when more were left out, or when not every repository could be checked (at most 100 an answer): \`head_cursor\` is then the feed's start.",
        "operationId": "feed.sync",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "complete": {
                      "type": "boolean",
                    },
                    "head_cursor": {
                      "description": "Pass as \`since\` to \`GET /feed\` for what changes next.",
                      "maxLength": 200,
                      "type": "string",
                    },
                    "items": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "acked_epoch": {
                            "description": "The epoch of the version last acknowledged; 0 for none.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "acked_version": {
                            "description": "The version last acknowledged; 0 for none.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "action": {
                            "description": "What happened last: \`comment\`, \`review_requested\`, \`merged\`, ...",
                            "type": "string",
                          },
                          "actor": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "actor_trust": {
                            "description": "The actor's access to the repository when it acted.",
                            "enum": [
                              "write",
                              "read",
                              "none",
                            ],
                            "type": "string",
                          },
                          "epoch": {
                            "description": "The repository's restore generation \`version\` counts in: a newer generation's versions are newer, whatever their numbers.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "event_at": {
                            "description": "When the last change happened, Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "excerpt": {
                            "description": "What the member the item displays says now (plain text, at most 280 characters), read from the repository; null when there is none or it is gone.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "item_key": {
                            "description": "The item's key: \`<repository id>:<thread>:<kind>\`.",
                            "type": "string",
                          },
                          "kind": {
                            "enum": [
                              "review_requested",
                              "changes_requested",
                              "approved",
                              "merge_conflict",
                              "assigned",
                              "mention",
                              "activity",
                            ],
                            "type": "string",
                          },
                          "members": {
                            "description": "For \`activity\`: the ids it gathers (comments, reviews), the greatest 100.",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "members_truncated": {
                            "description": "Some members were left out.",
                            "type": "boolean",
                          },
                          "priority": {
                            "description": "P0: act on this; P1: a thread you take part in.",
                            "enum": [
                              "P0",
                              "P1",
                            ],
                            "type": "string",
                          },
                          "reasons": {
                            "description": "Why it is in the feed: author, reviewer, mentioned, ...",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "repo": {
                            "additionalProperties": false,
                            "properties": {
                              "full_name": {
                                "description": "owner/name",
                                "type": "string",
                              },
                              "id": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "id",
                              "full_name",
                            ],
                            "type": "object",
                          },
                          "silent": {
                            "description": "The last change was the owner's own action (or its agents'): no notification.",
                            "type": "boolean",
                          },
                          "state": {
                            "description": "\`resolved\`: nothing to act on any more.",
                            "enum": [
                              "open",
                              "resolved",
                            ],
                            "type": "string",
                          },
                          "subject": {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "issue",
                                  "pull",
                                ],
                                "type": "string",
                              },
                              "number": {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              "title": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "number",
                              "title",
                            ],
                            "type": "object",
                          },
                          "thread_key": {
                            "description": "The thread within the repository, e.g. \`pull/12\` or \`issue/7\`.",
                            "type": "string",
                          },
                          "version": {
                            "description": "The thread's feed version the item is at; acknowledge with it and \`epoch\`.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "item_key",
                          "repo",
                          "thread_key",
                          "kind",
                          "subject",
                          "epoch",
                          "version",
                          "state",
                          "priority",
                          "reasons",
                          "silent",
                          "action",
                          "actor",
                          "actor_trust",
                          "excerpt",
                          "members",
                          "members_truncated",
                          "event_at",
                          "acked_epoch",
                          "acked_version",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "poll_after_ms": {
                      "description": "Wait at least this long (milliseconds) before polling \`GET /feed\` again with \`next_cursor\` (a sync's \`head_cursor\`): 0 after a full page, as more may follow; else 30 seconds after an answer that showed something, or a sync, doubling with each answer in a row that showed nothing (the cursor counts them), up to 30 minutes.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "items",
                    "complete",
                    "head_cursor",
                    "poll_after_ms",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Sync the activity feed",
        "x-fyrden-permission": "authenticated",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
    },
    "/grants": {
      "get": {
        "description": "The grants you made (a user), or that you hold or passed down (an agent), newest first; revoked ones too.",
        "operationId": "grants.list",
        "parameters": [
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size, 1-100.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "From a previous page's \`next_cursor\`.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "grants": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "agent": {
                            "description": "The handle of the agent the grant lets act.",
                            "type": "string",
                          },
                          "agent_id": {
                            "type": "string",
                          },
                          "created_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "depth": {
                            "description": "1 for a user's grant, 2 for a sub-agent's.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "expires_at": {
                            "description": "Unix time in milliseconds.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "grantor": {
                            "description": "The handle of the user the agent acts for.",
                            "type": "string",
                          },
                          "grantor_id": {
                            "type": "string",
                          },
                          "id": {
                            "description": "Grant id (grt_ prefix).",
                            "type": "string",
                          },
                          "parent_id": {
                            "description": "The grant this one was passed down from (to a sub-agent); null for a user's own.",
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                          "repositories": {
                            "anyOf": [
                              {
                                "items": {
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Repository ids the grant is limited to; null for every one the user can reach.",
                          },
                          "revoked_at": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "root_id": {
                            "description": "The user's grant at the top of the chain.",
                            "type": "string",
                          },
                          "scopes": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                        },
                        "required": [
                          "id",
                          "grantor",
                          "grantor_id",
                          "agent",
                          "agent_id",
                          "parent_id",
                          "root_id",
                          "depth",
                          "scopes",
                          "repositories",
                          "expires_at",
                          "created_at",
                          "revoked_at",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "next_cursor": {
                      "description": "Pass as \`cursor\` for the next page; null on the last page.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                  },
                  "required": [
                    "grants",
                    "next_cursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "List delegation grants",
        "x-fyrden-permission": "grants:read",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
      },
      "post": {
        "description": "Lets an agent act for you, limited to \`scopes\`, \`repositories\` and an expiry: the agent exchanges its own token for a delegated one (\`POST /oauth/token\`, RFC 8693). An agent holding a grant may pass a narrower one (\`parent\`) to another agent of its owner, one hop down at most. Revoking a grant revokes the tokens issued under it and its sub-grants.",
        "operationId": "grants.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "agent": {
                    "description": "The agent's handle.",
                    "maxLength": 39,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
                    "type": "string",
                  },
                  "expires_in_days": {
                    "default": 30,
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "parent": {
                    "description": "For an agent: the grant it holds and passes a narrower one of to another agent.",
                    "pattern": "^grt_[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string",
                  },
                  "repositories": {
                    "description": "\`owner/name\` of each repository it is limited to; every one you can reach when absent.",
                    "items": {
                      "pattern": "^[^/\\s]+\\/[^/\\s]+$",
                      "type": "string",
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array",
                  },
                  "scopes": {
                    "description": "Permissions the agent may use for you (and what they imply).",
                    "items": {
                      "enum": [
                        "instance:admin",
                        "repos:create",
                        "members:read",
                        "members:write",
                        "starring:read",
                        "starring:write",
                        "ssh_signing_keys:read",
                        "ssh_signing_keys:write",
                        "tokens:read",
                        "tokens:write",
                        "agents:read",
                        "agents:write",
                        "grants:read",
                        "grants:write",
                        "metadata:read",
                        "contents:read",
                        "contents:write",
                        "pull_requests:read",
                        "pull_requests:write",
                        "issues:read",
                        "issues:write",
                        "administration:write",
                        "repository_hooks:read",
                        "repository_hooks:write",
                      ],
                      "type": "string",
                    },
                    "maxItems": 32,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [
                  "agent",
                  "scopes",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "agent": {
                      "description": "The handle of the agent the grant lets act.",
                      "type": "string",
                    },
                    "agent_id": {
                      "type": "string",
                    },
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "depth": {
                      "description": "1 for a user's grant, 2 for a sub-agent's.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "expires_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "grantor": {
                      "description": "The handle of the user the agent acts for.",
                      "type": "string",
                    },
                    "grantor_id": {
                      "type": "string",
                    },
                    "id": {
                      "description": "Grant id (grt_ prefix).",
                      "type": "string",
                    },
                    "parent_id": {
                      "description": "The grant this one was passed down from (to a sub-agent); null for a user's own.",
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "repositories": {
                      "anyOf": [
                        {
                          "items": {
                            "type": "string",
                          },
                          "type": "array",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Repository ids the grant is limited to; null for every one the user can reach.",
                    },
                    "revoked_at": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "root_id": {
                      "description": "The user's grant at the top of the chain.",
                      "type": "string",
                    },
                    "scopes": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "id",
                    "grantor",
                    "grantor_id",
                    "agent",
                    "agent_id",
                    "parent_id",
                    "root_id",
                    "depth",
                    "scopes",
                    "repositories",
                    "expires_at",
                    "created_at",
                    "revoked_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Create a delegation grant",
        "x-fyrden-permission": "grants:write",
        "x-fyrden-principals": [
          "user",
          "agent",
        ],
        "x-idempotency": "Idempotency-Key header",
      },
    },
    "/grants/{grant_id}": {
      "delete": {
        "description": "Revokes a grant and the grants passed down from it: every token issued under them stops working at once for writes (within 30 seconds for reads). Its user, or the agent that passed it down, may revoke it.",
        "operationId": "grants.revoke",
        "parameters": [
          {
            "in": "path",
            "name": "grant_id",
            "required": true,
            "schema": {
              "description": "The grant's id.",
              "pattern": "^grt_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "agent": {
                      "description": "The handle of the agent the grant lets act.",
                      "type": "string",
                    },
                    "agent_id": {
                      "type": "string",
                    },
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "depth": {
                      "description": "1 for a user's grant, 2 for a sub-agent's.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "expires_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "grantor": {
                      "description": "The handle of the user the agent acts for.",
                      "type": "string",
                    },
                    "grantor_id": {
                      "type": "string",
                    },
                    "id": {
