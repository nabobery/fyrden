              "type": "string",
            },
          },
          {
            "in": "path",
            "name": "issue_number",
            "required": true,
            "schema": {
              "description": "The issue's or pull request's number.",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "content": {
                    "enum": [
                      "+1",
                      "-1",
                      "laugh",
                      "confused",
                      "heart",
                      "hooray",
                      "rocket",
                      "eyes",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "content",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "content": {
                      "enum": [
                        "+1",
                        "-1",
                        "laugh",
                        "confused",
                        "heart",
                        "hooray",
                        "rocket",
                        "eyes",
                      ],
                      "type": "string",
                    },
                    "created_at": {
                      "description": "Unix time in milliseconds.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "id": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "performed_via_agents": {
                      "description": "Fyrden: the agents that reacted for \`user\`, the acting one first; empty if none.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "user": {
                      "additionalProperties": false,
                      "description": "Who reacted (the user, when agents acted for one).",
                      "properties": {
                        "id": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "id",
                    "user",
                    "performed_via_agents",
                    "content",
                    "created_at",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Created",
          },
          "default": {
            "content": {
              "application/problem+json": {
