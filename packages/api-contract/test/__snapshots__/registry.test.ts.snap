      "post": {
        "description": "Comments on lines of a file in a pull request's diff, starting a thread; with \`in_reply_to\`, replies in that comment's thread instead (no anchor then). \`commit_id\` must be a head the pull request has had; \`side\` RIGHT comments on that commit's file, LEFT on the merge base's; the file must have the lines (whether they are part of the diff is not checked). Anyone who can read the repository may comment.",
        "operationId": "pulls.comments.create",
        "parameters": [
          {
            "in": "path",
            "name": "owner",
            "required": true,
            "schema": {
              "description": "The owner's handle.",
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
