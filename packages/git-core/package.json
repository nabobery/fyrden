{
  "name": "@fyrden/git-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript git engine: pkt-line, protocol v2, packs, deltas, commit graph, merge. No Cloudflare imports.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./testing/index.ts",
    "./testing/git-cli": "./testing/git-cli.ts",
    "./testing/ext-transport": "./testing/ext-transport/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "mutation": "stryker run",
    "fuzz": "vitest run -c vitest.fuzz.config.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
