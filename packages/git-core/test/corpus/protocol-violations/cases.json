{
  "description": "Protocol inputs that must be refused with a typed ProtocolError (code). Modelled on git's t5704-protocol-violations and pkt-line tests. input parts: a string (one byte per character), {pkt, count?} (a pkt-line, repeated), {repeat, count}. git: the git service (stateless-rpc) that also refuses the input; absent where Fyrden is stricter than git or the limit is Fyrden's own.",
  "cases": [
    {
      "name": "length with a non-hex digit",
      "target": "pkt-line",
      "input": ["00g4abcd"],
      "code": "invalid-length",
      "git": "upload-pack",
      "source": "git t/t0070-fundamental.sh and pkt-line.c packet_read_with_status"
    },
    {
      "name": "length with a sign",
      "target": "pkt-line",
      "input": ["-004"],
      "code": "invalid-length",
      "git": "upload-pack"
    },
    {
      "name": "length with a space",
      "target": "pkt-line",
      "input": [" 004"],
      "code": "invalid-length",
      "git": "upload-pack"
    },
    {
      "name": "length 0003",
      "target": "pkt-line",
      "input": ["0003"],
      "code": "invalid-length",
      "git": "upload-pack",
      "source": "git t/t0070-fundamental.sh and pkt-line.c packet_read_with_status"
    },
