{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  // The import-boundary test walks every workspace package's dependencies
  // and lints probes against the root biome.json (a global dependency).
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tools/*/package.json"
      ]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tools/*/package.json"
      ]
    }
  }
}
