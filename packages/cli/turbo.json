{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  // The deploy tests run against the real Workers' configs and the API's
  // migrations, which live in apps/ (not dependencies of this package).
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/api/wrangler.jsonc",
        "$TURBO_ROOT$/apps/web/wrangler.jsonc",
        "$TURBO_ROOT$/apps/api/migrations/**"
      ]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/api/wrangler.jsonc",
        "$TURBO_ROOT$/apps/web/wrangler.jsonc",
        "$TURBO_ROOT$/apps/api/migrations/**"
      ]
    }
  }
}
