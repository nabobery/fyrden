{
  // Test-only Worker config: runs this package's tests inside workerd and
  // generates runtime types. Nothing here is deployed.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fyrden-adapters-cloudflare-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "MIGRATION_PROBE", "class_name": "MigrationProbeDO" },
      { "name": "GIT_STORE_PROBE", "class_name": "GitStoreProbeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MigrationProbeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["GitStoreProbeDO"] }
  ],
  "r2_buckets": [{ "binding": "GIT", "bucket_name": "fyrden-git-test" }]
}
