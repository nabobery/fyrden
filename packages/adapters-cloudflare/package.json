{
  "name": "@fyrden/adapters-cloudflare",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare implementations of the git-core and domain ports (R2, Durable Object SQLite, D1, Queues, KV, Cache API).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations/index.ts",
    "./obs": "./src/obs/index.ts",
    "./obs/testing": "./src/obs/fake-dataset.ts",
    "./auth": "./src/auth/index.ts",
    "./net": "./src/net/index.ts",
    "./git": "./src/git/index.ts"
  },
  "scripts": {
    "typecheck": "wrangler types --check && tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "types": "wrangler types",
    "test:shuffle": "fyrden-shuffle-guard"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@fyrden/testing": "workspace:*",
    "@msw/cloudflare": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "fast-check": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@fyrden/domain": "workspace:*",
    "@fyrden/git-core": "workspace:*"
  }
}
