{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fyrden-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    // Query strings can carry tokens; never store them in logs or traces.
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "upload_source_maps": true,
  "services": [{ "binding": "API", "service": "fyrden-api", "entrypoint": "ApiRpc" }],
  // The tail() handler writes fyrden-api's per-invocation CPU and wall time
  // here, into the same dataset as fyrden-api's own metrics.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "fyrden_metrics" }]
}
