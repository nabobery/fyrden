{
  "name": "@fyrden/api",
  "version": "0.0.0",
  "private": true,
  "description": "fyrden-api Worker: REST, MCP, git smart HTTP, runner protocol and all Durable Objects.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc -p .",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "test:shuffle": "fyrden-shuffle-guard",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fyrden/adapters-cloudflare": "workspace:*",
    "@fyrden/api-contract": "workspace:*",
    "@fyrden/domain": "workspace:*",
    "@fyrden/git-core": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "@fyrden/testing": "workspace:*",
    "@types/node": "catalog:"
  }
}
