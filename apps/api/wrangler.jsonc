{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fyrden-api",
  "main": "src/index.ts",
  // Pinned and bumped deliberately. From 2026-08-04 nodejs_compat is on by default.
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    // Query strings can carry tokens; never store them in logs or traces.
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    // Sampled to keep trace volume low; raise while debugging.
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  "durable_objects": {
    "bindings": [
      { "name": "REPO", "class_name": "RepoDO" },
      { "name": "NETWORK", "class_name": "NetworkDO" },
      { "name": "ORG", "class_name": "OrgDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "RUN", "class_name": "RunDO" },
      // One user deletion's runner (its alarm advances the job).
      { "name": "DELETION", "class_name": "DeletionDO" },
      // Runs the five-minute maintenance cron's work, with a Durable Object's CPU.
      { "name": "MAINTENANCE", "class_name": "MaintenanceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoDO", "NetworkDO", "OrgDO", "UserDO", "RunDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DeletionDO"] },
    { "tag": "v3", "new_sqlite_classes": ["MaintenanceDO"] }
  ],

  // Database ids are filled in per deployment by `fyrden deploy`.
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "fyrden-directory",
      "migrations_dir": "migrations/directory"
    },
    // Read models for the deployment's org (one org per deployment for now).
    { "binding": "ORG_READ", "database_name": "fyrden-org", "migrations_dir": "migrations/org" }
  ],

  "r2_buckets": [
    { "binding": "GIT", "bucket_name": "fyrden-git" },
    { "binding": "CI", "bucket_name": "fyrden-ci" },
    { "binding": "SEARCH", "bucket_name": "fyrden-search" },
    // Release assets, attachments, audit archives and org exports.
    { "binding": "ASSETS", "bucket_name": "fyrden-assets" }
    // fyrden-lfs is reserved for Git LFS and not bound yet.
  ],

  "queues": {
    "producers": [
      { "binding": "EVENTS", "queue": "fyrden-events" },
      { "binding": "WEBHOOKS", "queue": "fyrden-webhooks" },
      // Each effect sink's queue: the ids of effects the events consumer journaled.
      { "binding": "EFFECTS_WEBHOOKS", "queue": "fyrden-effects-webhooks" },
      { "binding": "EFFECTS_FEED", "queue": "fyrden-effects-feed" },
      { "binding": "EFFECTS_REFERENCES", "queue": "fyrden-effects-references" },
      { "binding": "CI_DISPATCH", "queue": "fyrden-ci-dispatch" },
      { "binding": "INDEXING", "queue": "fyrden-indexing" }
    ],
    "consumers": [
      // Batch size, retries and the dead-letter queue are Proposed, sized for
      // the consumer's CPU and D1 query budgets on Free.
      {
        "queue": "fyrden-events",
        "max_batch_size": 5,
        // A second at most before a message is taken: notifications wait on it. Queues bill
        // per message, not per batch, so a shorter wait costs no operations.
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "fyrden-events-dlq"
      },
      // One delivery attempt per message, each acknowledged: the deliveries
      // table schedules retries (a new message each); the cron resends lost ones.
      // What the events consumer gave up on: stored, each before it is acknowledged.
      {
        "queue": "fyrden-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10
      },
      { "queue": "fyrden-webhooks", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 2 },
      // Effects: the journal decides and schedules (a retry is a new message), and the effects
      // cron sends a message again for an effect overdue, so no dead-letter queue. Batch sizes
      // keep an invocation short, so the effects behind it wait little (a consumer gets 30 s of
      // CPU on Free as on Paid): a message names up to 2 webhook effects (an event's deliveries
      // each), 8 feed effects or one feed audience page (up to 101 calls), or 10 references.
      {
        "queue": "fyrden-effects-webhooks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      {
        "queue": "fyrden-effects-feed",
        // Up to 4 messages: an event's pages, each a message of its own, delivered in one
        // invocation through its pool of calls (Queues add consumers only for a larger backlog).
        "max_batch_size": 4,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      {
        "queue": "fyrden-effects-references",
        "max_batch_size": 2,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      { "queue": "fyrden-ci-dispatch" },
      { "queue": "fyrden-indexing" }
    ]
  },

  // Archives the directory's audit log to R2 and the other maintenance
  // tasks; the second, offset, sends overdue effects again and reconciles
  // webhook deliveries in an invocation of its own (each has its own 1,000
  // calls on Free). Proposed intervals; Free allows a few cron triggers per
  // account.
  // Maintenance, effects, and the user deletions' recovery (each on its own, so none shares
  // another's CPU time).
  "triggers": { "crons": ["*/5 * * * *", "2-59/5 * * * *", "4-59/5 * * * *"] },

  // Cache only; never an authoritative store.
  "kv_namespaces": [{ "binding": "CACHE" }],

  "ratelimits": [
    { "name": "RATE_LIMIT_READ", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    {
      "name": "RATE_LIMIT_WRITE",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_HEALTHZ",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    // Per client address, before any token lookup.
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "1004",
      "simple": { "limit": 1200, "period": 60 }
    },
    // Unsubscribe links: per client address for links that do not verify, per address and list
    // for one-click posts of links that do (a mail provider's shared egress blocks no one).
    {
      "name": "RATE_LIMIT_UNSUBSCRIBE_IP",
      "namespace_id": "1005",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_UNSUBSCRIBE",
      "namespace_id": "1006",
      "simple": { "limit": 10, "period": 60 }
    },
    // The email provider's callbacks (/auth/email/events): spent only by requests whose
    // signature does not verify, by client address.
    {
      "name": "RATE_LIMIT_EMAIL_EVENTS_IP",
      "namespace_id": "1007",
      "simple": { "limit": 120, "period": 60 }
    }
  ],

  // Uploaded with the first deploy by `fyrden deploy` (--secrets-file): the first-run setup's
  // secret, and the platform's commit signing key. Listed, they also reach `wrangler dev` from an
  // env file (only listed secrets do).
  "secrets": { "required": ["BOOTSTRAP_SECRET", "SIGNING_KEY", "WEBHOOKS_KEY", "EMAIL_KEY"] },

  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "fyrden_metrics" }],

  // fyrden-web's tail() handler turns fyrden-api exceptions and CPU-limit
  // errors into alert metrics, so alerting needs no third Worker.
  "tail_consumers": [{ "service": "fyrden-web" }]
}
